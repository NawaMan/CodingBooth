*.o
*.obj
*.exe
*.out
*.dll
*.so
*.dylib
build/
cmake-build-*/

# --- Node (if you add web bits later) ---
node_modules/
dist/
build/

# Cosign / key material
cosign.key
cosign*.key
*.pem

# --- Misc caches ---
coverage/
.nyc_output/

examples/java-example/.classpath
examples/java-example/.project
examples/java-example/.settings/org.eclipse.jdt.core.prefs
examples/java-example/.settings/org.eclipse.m2e.core.prefs
examples/java-example/.settings/
examples/go-example/bin/
runner/.workspace/

tests/basic/test*.sh.log
tests/basic/test--dockerfile
tests/dryrun/test--.env
tests/dryrun/test--config.sh
tests/dryrun/test--config.toml
# tests/config/test*.sh writes its `$prj` working dir + recipe input into
# tests/config/prj--*; these are regenerated every run (and bake the host's
# absolute path into a header comment), so they shouldn't be tracked.
tests/config/prj--*/
tests/config/prj--*--recipe.txt
# Same test working dirs, but when the suite is run from another cwd (e.g. the
# repo root) the `prj--*` dir lands there instead — ignore it anywhere.
prj--*/
prj--*--recipe.txt
# .NET intermediate build output (csharp-example / fsharp-example)
**/obj/
**/.Dockerfile.generated
**/.booth/.tmp/
# Generated at booth run time (e.g. egress/envoy.generated.yaml, codingbooth.lock).
**/.booth/tools/

playground/

demos/.Trash-1000/

# Virtual environments (Python)
venv/
ENV/
env/
*.venv/

# Poetry virtualenvs inside `__pypackages__`
__pypackages__/


bin/
workspace.sh

/workspace
