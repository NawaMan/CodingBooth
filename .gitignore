# --- OS cruft ---
.DS_Store
Thumbs.db

# --- Git / tooling ---
.git/
.gitignore
*.log

# --- Booth local cache ---
# The cache holds whatever the container writes to mounted paths: shell history, browser
# profiles, and live credentials (~/.claude/.credentials.json arrives via the cb-home
# override layer). It must never be committed. Booth refuses to start if it is tracked.
# Spelled out here because the per-project .booth/.gitignore that normally carries this
# rule is itself covered by the '.gitignore' line above, so it never reaches a clone.
**/.booth/cache/

# --- Env & secrets ---
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*

# --- Editors & IDEs ---
.vscode/*
!.vscode/extensions.json        # keep extension recommendations
!.vscode/settings.json          # (optional) keep shared settings
.idea/
*.swp

# --- Docker ---
docker-compose.override.yml
**/.dockerignore

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.mypy_cache/
.pytest_cache/
.venv/
venv/

