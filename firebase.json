{
  "hosting": {
    "site": "codingbooth-blog",
    "public": "site",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/guides/clipboard.md",
        "destination": "/guides/clipboard.html",
        "type": 301
      }
    ]
  },
  "firestore": {
    "rules": "blog/firestore.rules"
  },
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "CodingBooth Blog",
        "supportEmail": "nawaman@gmail.com"
      }
    },
    "authorizedDomains": [
      "codingbooth.io",
      "codingbooth-blog.web.app",
      "codingbooth-blog.firebaseapp.com",
      "localhost"
    ]
  }
}
