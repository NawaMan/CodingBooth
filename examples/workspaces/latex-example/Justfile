# {{run-in-booth}} runs a line in this project's booth (starting one if needed),
# {{run-on-host}} keeps a line on the host. From `booth just-init`:
# https://github.com/NawaMan/CodingBooth/blob/main/docs/just/Justfile
booth        := env("BOOTH", "./booth")
run-in-booth := if env("BOOTH_CONTAINER_NAME", "") == "" { booth + " exec --run --" } else { "" }
run-on-host  := if env("BOOTH_CONTAINER_NAME", "") == "" { "" } else { "echo 'just: this recipe runs on the host - exit the booth and run it there.' >&2; exit 2;" }

[private]
default:
    @just --list

# Build main.pdf (latexmk runs pdflatex and BibTeX as many times as needed)
build:
    {{run-in-booth}} latexmk -pdf -interaction=nonstopmode -halt-on-error main.tex

# Rebuild main.pdf on every save, until Ctrl+C
watch:
    {{run-in-booth}} latexmk -pdf -pvc -view=none -interaction=nonstopmode main.tex

# Remove build artifacts but keep main.pdf
clean:
    {{run-in-booth}} latexmk -c -bibtex main.tex

# Remove build artifacts and main.pdf
clean-all:
    {{run-in-booth}} latexmk -C -bibtex main.tex
