arg PYTHON_VERSION=3.13.12

setup dotnet --channel ${DOTNET_CHANNEL}
setup dotnet ${DOTNET_CHANNEL}
setup go ${GO_VERSION}                                # GO tool chain
install go golang.org/x/tools/gopls@latest            # GO language server
install go github.com/go-delve/delve/cmd/dlv@latest   # Debugger
setup jdk ${JDK_VERSION} ${JDK_VENDOR}
setup mvn ${MAVEN_VERSION}
setup nodejs ${NODE_VERSION}
setup python ${PYTHON_VERSION}
