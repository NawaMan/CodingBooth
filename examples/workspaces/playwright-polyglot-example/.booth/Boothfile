setup playwright ${PLAYWRIGHT_BROWSERS} --version ${PLAYWRIGHT_VERSION}
setup dotnet-code-extension
setup dotnet-code-extension
setup go-code-extension
setup java-code-extension
setup playwright-code-extension
setup python-code-extension
run dotnet tool install --global Microsoft.Playwright.CLI || true
run if [ "${PLAYWRIGHT_VERSION}" = "latest" ]; then pip install playwright; else pip install "playwright==${PLAYWRIGHT_VERSION}"; fi
