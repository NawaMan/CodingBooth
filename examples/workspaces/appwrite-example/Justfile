# {{run-in-booth}} runs a line in this project's booth (starting one if needed),
# {{run-on-host}} keeps a line on the host. From `booth just-init`:
# https://github.com/NawaMan/CodingBooth/blob/main/docs/just/Justfile
run-in-booth := if env("BOOTH_CONTAINER_NAME", "") == "" { "./booth exec --run --" } else { "" }
run-on-host  := if env("BOOTH_CONTAINER_NAME", "") == "" { "" } else { "echo 'just: this recipe runs on the host - exit the booth and run it there.' >&2; exit 2;" }

[private]
default:
    @just --list

# Wait for the local Appwrite, print CLI version and API health
run:
    {{run-in-booth}} ./demo.sh

# Create the starter project in the local Appwrite and write starter-for-svelte/.env
app:
    {{run-in-booth}} ./appwrite-app.sh

# Run starter-for-svelte against the local Appwrite (Vite on :5173)
web:
    {{run-in-booth}} ./web.sh

# Follow Appwrite's request log: one line per /v1/ping as it arrives (Ctrl+C stops)
watch:
    {{run-in-booth}} ./watch-pings.sh

# Print how many pings the starter project has received (pingCount, pingedAt)
pings:
    {{run-in-booth}} ./pings.sh
