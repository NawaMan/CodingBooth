# {{run-in-booth}} runs a line in this project's booth (starting one if needed),
# {{run-on-host}} keeps a line on the host. From `booth just-init`:
# https://github.com/NawaMan/CodingBooth/blob/main/docs/just/Justfile
booth        := env("BOOTH", "./booth")
own-booth    := if justfile_directory() == "/home/coder/code" { "true" } else if path_exists(justfile_directory() / ".booth") == "true" { "false" } else { "true" }
run-in-booth := if env("CB_TARGET", "booth") != "booth" { "" } else if env("BOOTH_CONTAINER_NAME", "") == "" { booth + " exec --run --" } else if own-booth == "true" { "" } else { "echo 'just: " + file_name(justfile_directory()) + " has its own booth, and this is the " + env("BOOTH_CONTAINER_NAME") + " booth - exit it and run the recipe on the host.' >&2; exit 2;" }
run-on-host  := if env("BOOTH_CONTAINER_NAME", "") == "" { "" } else { "echo 'just: this recipe runs on the host - exit the booth and run it there.' >&2; exit 2;" }

[private]
default:
    @just --list

# Load the demo product catalog into PostgreSQL (idempotent, safe to re-run)
seed:
    {{run-in-booth}} psql -d postgres -f seed.sql

[private]
demo-impl:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "== All products =="
    curl -s http://localhost:3000/products
    echo ""
    echo ""
    echo "== Fuzzy search for the misspelled 'Runing Shoez' (pg_trgm ranks by similarity, not exact match) =="
    curl -s -X POST http://localhost:3000/rpc/search_products \
        -H "Content-Type: application/json" \
        -d '{"query": "Runing Shoez"}'
    echo ""
    echo ""
    echo "== Nearest neighbors to a hiking-ish embedding (pgvector) =="
    curl -s -X POST http://localhost:3000/rpc/match_products \
        -H "Content-Type: application/json" \
        -d '{"query_embedding": [0.75, 0.2, 0.05], "match_count": 2}'
    echo ""

# Walk through the API: list all products, a fuzzy name search (pg_trgm), and
# a nearest-neighbor similarity search (pgvector) via a PostgREST RPC call
demo:
    {{run-in-booth}} just demo-impl
