# This project's commands - run `just` to list them.  https://just.systems
#
# Every recipe works the same from the host and from inside the booth. Start a
# recipe line with where it must run:
#
#   {{run-in-booth}}  On the host: `./booth exec --run --`, which runs the line in
#                     this project's booth, starting one first if none is running
#                     (and stopping it again after). Inside the booth: as is.
#                     Inside another project's booth (a parent folder's, say):
#                     refused, as that booth lacks this project's tools.
#   {{run-on-host}}   On the host: as is. Inside the booth: refused, for lines that
#                     drive the booth from outside (./booth ...).
#
# The host shell reads a {{run-in-booth}} line first: wrap $VAR, $(...), | and &&
# in bash -c '...' to have the booth expand them instead. Each such line is its
# own `booth exec`, so a multi-line job is quicker as one script.
#
# No `just` on the host? `./booth exec --run -- just <recipe>` does the same.
#
# Created by `booth just-init`, from
# https://github.com/NawaMan/CodingBooth/blob/main/docs/just/Justfile

booth        := env("BOOTH", "./booth")
own-booth    := if justfile_directory() == "/home/coder/code" { "true" } else if path_exists(justfile_directory() / ".booth") == "true" { "false" } else { "true" }
run-in-booth := if env("BOOTH_CONTAINER_NAME", "") == "" { booth + " exec --run --" } else if own-booth == "true" { "" } else { "echo 'just: " + file_name(justfile_directory()) + " has its own booth, and this is the " + env("BOOTH_CONTAINER_NAME") + " booth - exit it and run the recipe on the host.' >&2; exit 2;" }
run-on-host  := if env("BOOTH_CONTAINER_NAME", "") == "" { "" } else { "echo 'just: this recipe runs on the host - exit the booth and run it there.' >&2; exit 2;" }

[private]
default:
    @just --list

# Open the KDE desktop in the browser; the IDEs are in its application menu
desktop:
    {{run-on-host}} {{booth}}

# Run the three demos: Demo.sh, Demo.py and Demo.java (JDK 24, a preview-feature implicit class)
run:
    {{run-in-booth}} bash Demo.sh
    {{run-in-booth}} python3 Demo.py
    {{run-in-booth}} java --enable-preview --source 24 Demo.java

# Check the Python environment: interpreter, packages and Jupyter kernels
python-check:
    {{run-in-booth}} python3 Demo_PythonCheck.py

# Where each of the nine IDE launchers is on PATH
ides:
    {{run-in-booth}} bash -c 'for ide in idea pycharm goland webstorm phpstorm clion rider rubymine datagrip; do printf "%-9s %s\n" "$ide" "$(command -v "$ide" || echo MISSING)"; done'

# Open a shell in this project's booth, starting it if needed.
shell:
    {{run-on-host}} {{booth}} shell --run
