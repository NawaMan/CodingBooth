run := if env("BOOTH_CONTAINER_NAME", "") == "" { "./booth exec --run --" } else { "" }

[private]
default:
    @just --list

# Production build of the Vite client
build:
    {{run}} bash -c 'cd client && npm install && npm run build'

# Terminal 1 — Express API on :3000
server:
    {{run}} bash -c 'cd server && npm install && npm start'

# Terminal 2 — Vite dev server on :5173
client:
    {{run}} bash -c 'cd client && npm install && npm run dev'
