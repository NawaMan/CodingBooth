# {{run-in-booth}} runs a line in this project's booth (starting one if needed),
# {{run-on-host}} keeps a line on the host. From `booth just-init`:
# https://github.com/NawaMan/CodingBooth/blob/main/docs/just/Justfile
run-in-booth := if env("BOOTH_CONTAINER_NAME", "") == "" { "./booth exec --run --" } else { "" }
run-on-host  := if env("BOOTH_CONTAINER_NAME", "") == "" { "" } else { "echo 'just: this recipe runs on the host - exit the booth and run it there.' >&2; exit 2;" }
# Same, but keeps the booth running afterwards -- start-server.sh daemonizes
# and returns immediately, so a plain --run would tear the booth (and the
# detached servers with it) down right after start-server.sh exits.
run-in-booth-keep-alive := if env("BOOTH_CONTAINER_NAME", "") == "" { "./booth exec --run --keep-alive --" } else { "" }

[private]
default:
    @just --list

# Production build of the Vite client
build:
    {{run-in-booth}} bash -c 'npm install && npm run build'

# Typecheck the TypeScript
typecheck:
    {{run-in-booth}} bash -c 'npm install && npm run typecheck'

# Start API + Vite as daemons (`just start bun` for the API)
start runtime="npm":
    {{run-in-booth-keep-alive}} ./start-server.sh --runtime={{ runtime }}

# Stop both servers
stop:
    {{run-in-booth}} ./stop-server.sh

# Check whether both servers are up (`just check down`)
check expect="up":
    {{run-in-booth}} ./check-server.sh --expect={{ expect }}
