run := if env("BOOTH_CONTAINER_NAME", "") == "" { "./booth exec --run --" } else { "" }

[private]
default:
    @just --list

# Compile (deps are already in the image)
build:
    {{run}} mvn -q compile

# Compile and run App
run:
    {{run}} mvn compile -q exec:java -Dexec.mainClass=com.example.App
