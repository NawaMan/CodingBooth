# {{run-in-booth}} runs a line in this project's booth (starting one if needed),
# {{run-on-host}} keeps a line on the host. From `booth just-init`:
# https://github.com/NawaMan/CodingBooth/blob/main/docs/just/Justfile
booth        := env("BOOTH", "./booth")
own-booth    := if justfile_directory() == "/home/coder/code" { "true" } else if path_exists(justfile_directory() / ".booth") == "true" { "false" } else { "true" }
run-in-booth := if env("CB_TARGET", "booth") != "booth" { "" } else if env("BOOTH_CONTAINER_NAME", "") == "" { booth + " exec --run --" } else if own-booth == "true" { "" } else { "echo 'just: " + file_name(justfile_directory()) + " has its own booth, and this is the " + env("BOOTH_CONTAINER_NAME") + " booth - exit it and run the recipe on the host.' >&2; exit 2;" }
run-on-host  := if env("BOOTH_CONTAINER_NAME", "") == "" { "" } else { "echo 'just: this recipe runs on the host - exit the booth and run it there.' >&2; exit 2;" }

[private]
default:
    @just --list

# Print the installed bash-3.2 version (macOS still ships 3.2 as /bin/bash)
version:
    {{run-in-booth}} bash-3.2 --version

# Count zero arguments under bash 3.2. The empty array must not abort under set -u.
count:
    {{run-in-booth}} use-bash 3.2 ./scripts/count-args.sh

# Count two arguments under bash 3.2
count-two:
    {{run-in-booth}} use-bash 3.2 ./scripts/count-args.sh one two

# The same script on the image's own bash
count-distro:
    {{run-in-booth}} ./scripts/count-args.sh

# Each level of a #!/bin/bash script tree, on the image's bash
which-bash:
    {{run-in-booth}} ./scripts/which-bash.sh

# The same tree under use-bash 3.2: every level is 3.2, declare -A fails
which-bash-32:
    {{run-in-booth}} use-bash 3.2 ./scripts/which-bash.sh
