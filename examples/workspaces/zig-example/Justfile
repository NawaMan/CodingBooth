# Keep Zig's cache off the bind mount: on Windows hosts, Zig's cache rename
# into a mounted .zig-cache fails with AccessDenied.
export ZIG_LOCAL_CACHE_DIR := env_var_or_default("ZIG_LOCAL_CACHE_DIR", "/tmp/zig-cache")

[private]
default:
    @just --list

# Compile with zig build
build:
    zig build

# Build and run the primes demo (`just run 20`)
run *args:
    ./run-primes.sh {{ args }}
