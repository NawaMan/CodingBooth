# syntax=codingbooth/boothfile:1

# Kind App Example
# Full-stack development with Kubernetes, Go, Bun, Python, and LibreOffice

arg CB_GO_VERSION=1.25.3
arg CB_BUN_VERSION=1.3.6

# Setup DinD and Kubernetes
setup dind
setup kind
setup aws-cli

# Go development
setup go ${CB_GO_VERSION}
setup go-code-extension

# Bun for frontend
setup bun ${CB_BUN_VERSION}

# Python with Jupyter notebooks
setup python
setup notebook

setup claude-code
setup antigravity

# Install LibreOffice for document processing
run &&<<APT
apt update
apt install -y libreoffice libreoffice-gtk3
rm -rf /var/lib/apt/lists/*
APT
