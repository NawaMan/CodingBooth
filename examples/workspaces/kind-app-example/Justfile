# {{run-in-booth}} runs a line in this project's booth (starting one if needed),
# {{run-on-host}} keeps a line on the host. From `booth just-init`:
# https://github.com/NawaMan/CodingBooth/blob/main/docs/just/Justfile
run-in-booth := if env("BOOTH_CONTAINER_NAME", "") == "" { "./booth exec --run --" } else { "" }
run-on-host  := if env("BOOTH_CONTAINER_NAME", "") == "" { "" } else { "echo 'just: this recipe runs on the host - exit the booth and run it there.' >&2; exit 2;" }
# Same, but keeps the booth (and its DinD sidecar, which holds the cluster)
# running afterwards -- a plain --run would tear both down as soon as
# start-cluster.sh returns, taking the KinD cluster with it.
run-in-booth-keep-alive := if env("BOOTH_CONTAINER_NAME", "") == "" { "./booth exec --run --keep-alive --" } else { "" }

[private]
default:
    @just --list

# Create the KinD cluster
start:
    {{run-in-booth-keep-alive}} ./start-cluster.sh

# Build the app images
build:
    {{run-in-booth}} ./build.sh

# Deploy the TODO app
deploy:
    {{run-in-booth}} ./deploy-app.sh

# Port-forward the UI
access:
    {{run-in-booth}} ./access-app.sh

# One-shot health check
check:
    {{run-in-booth}} ./status.sh

# Delete the cluster
stop:
    {{run-in-booth}} ./stop-cluster.sh
