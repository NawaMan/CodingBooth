# This project's commands - run `just` to list them.  https://just.systems
#
# Every recipe works the same from the host and from inside the booth. Start a
# recipe line with where it must run:
#
#   {{run-in-booth}}  On the host: `./booth exec --run --`, which runs the line in
#                     this project's booth, starting one first if none is running
#                     (and stopping it again after). Inside the booth: as is.
#   {{run-on-host}}   On the host: as is. Inside the booth: refused, for lines that
#                     drive the booth from outside (./booth ...).
#
# The host shell reads a {{run-in-booth}} line first: wrap $VAR, $(...), | and &&
# in bash -c '...' to have the booth expand them instead. Each such line is its
# own `booth exec`, so a multi-line job is quicker as one script.
#
# No `just` on the host? `./booth exec --run -- just <recipe>` does the same.
#
# Created by `booth just-init`, from
# https://github.com/NawaMan/CodingBooth/blob/main/docs/just/Justfile

run-in-booth := if env("BOOTH_CONTAINER_NAME", "") == "" { "./booth exec --run --" } else { "" }
run-on-host  := if env("BOOTH_CONTAINER_NAME", "") == "" { "" } else { "echo 'just: this recipe runs on the host - exit the booth and run it there.' >&2; exit 2;" }

[private]
default:
    @just --list

# Run hello-js.ipynb and hello-ts.ipynb without a UI and print every cell's output
run:
    {{run-in-booth}} ./notebooks.sh run

# Show the TypeScript kernel rejecting the type error in type-error.ipynb
typecheck:
    {{run-in-booth}} ./notebooks.sh typecheck

# List the Jupyter kernels: javascript and typescript (tslab) next to python
kernels:
    {{run-in-booth}} jupyter kernelspec list

# Plain Node.js, no Jupyter: the version and a one-line script
node:
    {{run-in-booth}} node --version
    {{run-in-booth}} node -e 'console.log(`Node ${process.version}: ${[1, 2, 3].map((n) => n * n)}`)'

# Serve JupyterLab on :18888, opened through the booth port's /proxy/18888/ (Ctrl+C stops)
lab:
    {{run-in-booth}} ./lab.sh

# Open a shell in this project's booth, starting it if needed.
shell:
    {{run-on-host}} ./booth shell --run
