run := if env("BOOTH_CONTAINER_NAME", "") == "" { "./booth exec --run --" } else { "" }

[private]
default:
    @just --list

# Run the Playwright test suite
test:
    {{run}} ./run-playwright.sh

# Capture a screenshot (`just screenshot https://playwright.dev shot.png`)
screenshot *args:
    {{run}} ./run-screenshot.sh {{ args }}
