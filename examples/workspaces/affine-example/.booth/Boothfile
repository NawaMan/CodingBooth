arg AFFINE_SERVER_DATA=clean
arg AFFINE_SERVER_HOST_PORT=13010
arg AFFINE_SERVER_PORT=13010
arg AFFINE_SERVER_VERSION=stable
arg NODE_VERSION=22
arg PG_VERSION=latest
