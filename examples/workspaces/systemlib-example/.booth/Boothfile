# Configured by: booth config --no-tui --overwrite --select clang/cmake

env APT_SNAPSHOT=20260722T000000Z

arg LLVM_VERSION=18

setup clang --version ${LLVM_VERSION}
setup cmake
setup make --from-apt

# The point of this example: real system libraries, installed with apt and *linked*
# (not header-only). libcurl for HTTPS, SQLite for storage — both land as headers +
# shared objects that CMake's find_package(CURL) / find_package(SQLite3) resolve.
# ca-certificates so libcurl can verify HTTPS; sqlite3 is the CLI, handy for poking
# the resulting database by hand. APT_SNAPSHOT above pins them for reproducibility.
install apt libcurl4-openssl-dev libsqlite3-dev sqlite3 ca-certificates
