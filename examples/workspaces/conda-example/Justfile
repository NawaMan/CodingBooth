# {{run-in-booth}} runs a line in this project's booth (starting one if needed),
# {{run-on-host}} keeps a line on the host. From `booth just-init`:
# https://github.com/NawaMan/CodingBooth/blob/main/docs/just/Justfile
booth        := env("BOOTH", "./booth")
own-booth    := if justfile_directory() == "/home/coder/code" { "true" } else if path_exists(justfile_directory() / ".booth") == "true" { "false" } else { "true" }
run-in-booth := if env("CB_TARGET", "booth") != "booth" { "" } else if env("BOOTH_CONTAINER_NAME", "") == "" { booth + " exec --run --" } else if own-booth == "true" { "" } else { "echo 'just: " + file_name(justfile_directory()) + " has its own booth, and this is the " + env("BOOTH_CONTAINER_NAME") + " booth - exit it and run the recipe on the host.' >&2; exit 2;" }
run-on-host  := if env("BOOTH_CONTAINER_NAME", "") == "" { "" } else { "echo 'just: this recipe runs on the host - exit the booth and run it there.' >&2; exit 2;" }

[private]
default:
    @just --list --unsorted

# 1. API latency report from data/requests.csv (`just run /api/search` for one endpoint)
run *args:
    {{run-in-booth}} ./run-latency.sh {{ args }}

# 2. Run Latency.ipynb headlessly on the conda kernel, outputs into Latency.out.ipynb
latency-notebook:
    {{run-in-booth}} jupyter nbconvert --to notebook --execute Latency.ipynb --output Latency.out.ipynb

# 3. Drug-likeness of a molecule, by name or SMILES (`just molecule caffeine`)
molecule *args:
    {{run-in-booth}} ./run-molecule.sh {{ args }}

# 3. List the molecules the lab knows by name
molecules:
    {{run-in-booth}} ./run-molecule.sh --list

# 3. Run Molecules.ipynb headlessly on the conda kernel, outputs into Molecules.out.ipynb
molecule-notebook:
    {{run-in-booth}} jupyter nbconvert --to notebook --execute Molecules.ipynb --output Molecules.out.ipynb
