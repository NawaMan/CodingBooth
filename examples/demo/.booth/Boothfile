# syntax=codingbooth/boothfile:1

# Demo booth - showcases multiple languages and tools

# Build arguments for version pinning
arg JDK_VERSION=25
arg PY_VERSION=3.12
arg GO_VERSION=1.25.4
arg NODE_MAJOR=20

# Languages
setup python ${PY_VERSION}
setup jdk    ${JDK_VERSION}
setup go     ${GO_VERSION}
setup nodejs ${NODE_MAJOR}

# Force jbang to cache dependencies (avoid download on first run)
run echo 'class Hi { public static void main(String[] args) { System.out.println("Hi"); }}' | jbang -

# Build tools
setup mvn
setup gradle

# AI tools
setup claude-code

# VS Code extensions
setup java-code-extension
setup go-code-extension

# Jupyter notebooks with language kernels
setup notebook 18888
setup python-nb-kernel
setup bash-nb-kernel
setup java-jjava-nb-kernel
