#!/bin/bash
# booth--desktop-ready — is this booth's desktop display up?
#
#   exit 0  the display accepts connections; a GUI app started now will open
#   exit 1  not (yet): the desktop is still starting, or it is down
#   exit 2  nothing to check: this booth has no display to wait for
#
# `booth exec` polls it before running a command in a booth whose image is
# labelled com.codingbooth.desktop (the desktop variants), so `booth exec --run
# -- some-gui-app` does not start the app before its X server. It checks the
# display live rather than reading a marker file: /tmp survives a booth stop and
# start, so a marker from the last session would claim a desktop that is not up.
#
# Run it as the user whose session it checks (coder): the X server's auth cookie
# is in that user's ~/.Xauthority. "Up" means the X server answers; the window
# manager and panel may still be loading, which a GUI app does not need.
#
# Lives in base so every variant built FROM it has the same helper; only the
# images with the label ask for it.

case "${1:-}" in
  -h|--help)
    sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
esac

[[ -n "${DISPLAY:-}" ]] || exit 2
command -v xset >/dev/null 2>&1 || exit 2

xset q >/dev/null 2>&1 && exit 0
exit 1
