#!/usr/bin/env bash
set -euo pipefail

PORT=${1:-10000}

is_truthy() {
    case "${1,,}" in
        1|true|yes|on) return 0 ;;
        *) return 1 ;;
    esac
}

if is_truthy "${BOOTH_WEB_SPLIT:-true}"; then
    exec start-ttyd-split "$PORT"
fi

TTYD_ARGS=(-W -i 0.0.0.0 -p "$PORT" --writable)

if [[ -n "${PASSWORD:-}" ]]; then
    TTYD_ARGS+=(-c "coder:${PASSWORD}")
fi

exec ttyd "${TTYD_ARGS[@]}" bash -l
