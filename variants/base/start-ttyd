#!/usr/bin/env bash
set -euo pipefail

PORT=${1:-10000}

is_truthy() {
    case "${1,,}" in
        1|true|yes|on) return 0 ;;
        *) return 1 ;;
    esac
}

if is_truthy "${BOOTH_WEB_SPLIT:-true}"; then
    exec start-ttyd-split "$PORT"
fi

# -d 3 = libwebsockets LLL_ERR|LLL_WARN only. ttyd's default (7) also sets
# LLL_NOTICE, which logs every HTTP request plus a connection tag/untag pair
# for it straight to the container's stdout/stderr (docker logs) - errors and
# warnings still print at 3.
TTYD_ARGS=(-W -i 0.0.0.0 -p "$PORT" --writable -t 'fontFamily=FiraCode Nerd Font Mono' -d 3)

# No nginx sits in front of this mode to inject the font the way
# start-ttyd-split does, so this custom index (baked by
# ttyd-nerd-font-index--setup.sh) carries it embedded instead.
if [[ -f /usr/local/share/ttyd-nerd-font-index.html ]]; then
    TTYD_ARGS+=(-I /usr/local/share/ttyd-nerd-font-index.html)
fi

if [[ -n "${PASSWORD:-}" ]]; then
    TTYD_ARGS+=(-c "coder:${PASSWORD}")
fi

# A bare shell dies with the websocket connection (a reload SIGHUPs it,
# taking a foreground job like a dev server down too), so it lives inside a
# tmux session that a reconnect reattaches to instead of replacing.
exec ttyd "${TTYD_ARGS[@]}" tmux new-session -A -s main
