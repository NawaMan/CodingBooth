worker_processes auto;
pid /tmp/nginx-ttyd-split.pid;
error_log /tmp/nginx-error.log warn;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /tmp/nginx-access.log;
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    client_body_temp_path /tmp/nginx/body;
    proxy_temp_path /tmp/nginx/proxy;
    fastcgi_temp_path /tmp/nginx/fastcgi;
    uwsgi_temp_path /tmp/nginx/uwsgi;
    scgi_temp_path /tmp/nginx/scgi;

    # The session token in the gate below is a 64-character hex string, which
    # does not fit the default 64-byte bucket — nginx refuses to start with
    # "could not build map_hash" if this is left alone. It has to precede every
    # map block: once one has been parsed, nginx rejects this as a duplicate.
    map_hash_bucket_size 128;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Globe-proxied SPAs (Appwrite console, Vite apps, …) fetch `/v1/…` and
    # other root-absolute URLs against the booth origin. When the Referer is a
    # `/proxy/{port}/…` pane, send those to that port instead of the console UI.
    map $http_referer $cb_proxy_ref {
        default "";
        "~*^https?://[^/]+/proxy/([0-9]+)(/|$)" $1;
    }
    map $uri $cb_proxy_skip {
        default 0;
        "~*^/(s[1-4]|login)(/|$)" 1;
        "~*^/(booth|booth-messages|__booth|proxy)(/|$)" 1;
    }

    # Session gate. Generated by start-ttyd-split: when PASSWORD is set this
    # matches the booth_auth cookie against a per-start random token; when it is
    # unset it collapses to "default 1" and every gate below is a no-op.
    ${AUTH_MAP}

    server {
        listen ${PORT};
        server_name _;

        root ${WEB_SPLIT_SERVE};
        index index.html;

        # The gate's redirects must stay relative. nginx would otherwise build
        # them from the port it listens on (10000, or 10443 behind the TLS
        # proxy) and send the browser to a port that is not the published one.
        absolute_redirect off;

        # The login form itself is the one page reachable without a session.
        # Already signed in (or no password at all) => nothing to ask for.
        location = /login {
            # A globe-pane SPA (AnythingLLM, …) that does window.location =
            # "/login" hits this exact location on the booth origin. Serving
            # the gate here 302s an authed session to / and nests the whole
            # console in the iframe. Referer /proxy/<port>/ means send it
            # back under the pane prefix instead.
            if ($cb_proxy_ref != "") {
                return 302 /proxy/$cb_proxy_ref/login$is_args$args;
            }
            if ($booth_auth_ok = 1) {
                return 302 /;
            }
            try_files /login.html =404;
        }

        # ...and the endpoint that trades the password for the cookie.
        location = /booth-messages/api/login {
            proxy_pass http://127.0.0.1:10007;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_buffering off;
        }

        # Booth liveness — proxies to session 1's ttyd; 2xx/3xx/4xx → 200,
        # 5xx/timeout → unhealthy. It has to reach past nginx to mean anything:
        # nginx serves this page from disk the moment it starts, while the ttyd
        # processes behind it are still binding, so "the port answers" is not
        # "the booth is up". See BOOTH_HEALTH.md.
        #
        # Ungated on purpose. The CLI probes this before a browser is opened,
        # let alone a session cookie minted, and an "ok" gives away only that a
        # booth is serving here — which the redirect to /login already does.
        location = /__booth/health {
            access_log off;
            # Which booth is answering. A booth is reached by port, and ports get
            # reused: stop one booth and start another on the same port and a
            # browser tab left open from the first is still showing its page,
            # now driving a booth that never served it. The page carries this id
            # and reloads itself when it stops matching. `always` so the id is
            # on the 502 too — the swap is worth catching before the new booth
            # has finished starting.
            add_header X-Booth-Instance "${BOOTH_INSTANCE_ID}" always;
            # The un-slashed base path on purpose: ttyd answers it with an empty
            # 302 to /s1/, which the error_page list below turns into this
            # endpoint's own "ok" body. Asking for /s1/ would get a 200 instead,
            # and error_page cannot intercept a 200 — the whole 700 KB terminal
            # page would be returned as the health response, on every poll.
            proxy_pass http://127.0.0.1:10001/s1;
            ${TTYD_AUTH_HEADER}
            proxy_connect_timeout 2s;
            proxy_read_timeout 3s;
            proxy_intercept_errors on;
            error_page 301 302 303 304 307 308 400 401 402 403 404 405 406 407 408 409 410 411 412 413 414 415 416 417 418 422 429 =200 @__booth_alive;
        }

        location @__booth_alive {
            internal;
            default_type text/plain;
            add_header Cache-Control "no-store" always;
            # add_header does not inherit into a named location that sets any of
            # its own, so the instance id is repeated rather than shared.
            add_header X-Booth-Instance "${BOOTH_INSTANCE_ID}" always;
            return 200 "ok $time_iso8601\n";
        }

        # Fira Code Nerd Font Mono, served as a real cacheable asset so all 4
        # panes' @font-face rules (injected below) share one fetch instead of
        # each embedding its own copy. ttyd's terminal renders in the visitor's
        # own browser via canvas/WebGL — installing the font in this container
        # (fira-code-nerd-font--setup.sh) only lets the container *name* it via
        # ttyd's `-t fontFamily=` client option; a visitor whose browser never
        # requested this file would just fall back to its own default
        # monospace, silently.
        location /booth-assets/fonts/ {
            if ($booth_auth_ok = 0) {
                return 302 /login;
            }
            alias /usr/share/fonts/truetype/fira-code-nerd-font/;
            add_header Cache-Control "public, max-age=31536000, immutable";
        }

        location /s1/ {
            if ($booth_auth_ok = 0) {
                return 302 /login;
            }

            proxy_pass http://127.0.0.1:10001;
            proxy_http_version 1.1;
            ${TTYD_AUTH_HEADER}
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 24h;
            proxy_buffering off;

            # ttyd's page is a single self-contained HTML document (no
            # external assets), so this only has to fire once per pane load,
            # not on every websocket frame. See /booth-assets/fonts/ above.
            # sub_filter cannot rewrite a compressed body, and a real browser
            # (unlike curl) sends Accept-Encoding: gzip by default — without
            # this, ttyd answers compressed and the filter below silently
            # never matches. Same fix the /proxy/ location already needed.
            proxy_set_header Accept-Encoding "";
            sub_filter_once on;
            # Nerd Fonts are huge — this one is ~2.7MB as a .ttf, mostly the
            # thousands of icon glyphs patched in — so fira-code-nerd-font--setup.sh
            # also generates a .woff2 sibling (~1.2MB, WOFF2's font-specific
            # compression) for the browser to fetch instead; the preload link
            # below starts that fetch the instant this document's <head> is
            # parsed, rather than waiting for CSS to discover it's needed.
            #
            # None of that closes the race, though: ttyd's bundled xterm.js
            # measures its terminal cell width once, synchronously, against
            # whatever font is actually rendering at that instant — usually the
            # browser's fallback monospace, since the real font, however fast
            # it's fetched, still decodes asynchronously. xterm never re-measures
            # once the real font takes over, so every cell stays sized for the
            # fallback's (wider) advance width and the narrower Nerd Font glyphs
            # render with a gap between them.
            #
            # Calling xterm's own `_charSizeService.measure()` directly to force
            # a correction — tried twice, once as a single attempt and once
            # debounced on xterm's onRender going quiet — corrupted the terminal
            # (blank rows, or a stuck resize) whenever it landed while a
            # reattached tmux pane was replaying its buffer, reproduced live
            # against this exact page. A JS-triggered `location.reload()` was
            # tried next, on the theory that a manual hard refresh always fixes
            # this; it doesn't reliably — the reloaded page can lose the same
            # race again, and a reload has no in-place retry.
            #
            # This instead dispatches a plain `resize` event, which drives
            # ttyd's own window-resize handler — the same code path every
            # browser window resize already exercises, so it's expected to
            # handle a concurrent tmux replay correctly. The mismatch check
            # itself never touches xterm's internals: it independently measures
            # the loaded font with a throwaway canvas context (zero side
            # effects) and compares that to xterm's cached cell width, only
            # dispatching the resize when they actually disagree.
            sub_filter '<head>' '<head><link rel="preload" as="font" type="font/woff2" href="/booth-assets/fonts/FiraCodeNerdFontMono-Regular.woff2" crossorigin><link rel="preload" as="font" type="font/woff2" href="/booth-assets/fonts/FiraCodeNerdFontMono-Bold.woff2" crossorigin><style>@font-face{font-family:FiraCode Nerd Font Mono;font-weight:400;font-style:normal;font-display:swap;src:url(/booth-assets/fonts/FiraCodeNerdFontMono-Regular.woff2) format("woff2");}@font-face{font-family:FiraCode Nerd Font Mono;font-weight:700;font-style:normal;font-display:swap;src:url(/booth-assets/fonts/FiraCodeNerdFontMono-Bold.woff2) format("woff2");}</style><script>document.fonts.ready.then(function(){var checks=0;function check(){checks++;var t=window.term,s=t&&t._core&&t._core._charSizeService;if(s){try{var c=document.createElement("canvas").getContext("2d");c.font=(t.options.fontSize||15)+"px "+t.options.fontFamily;var want=c.measureText("W").width;if(Math.abs(s.width-want)>2){window.dispatchEvent(new Event("resize"));}}catch(e){}}if(checks<30){setTimeout(check,500);}}check();});</script>';
        }

        location /s2/ {
            if ($booth_auth_ok = 0) {
                return 302 /login;
            }

            proxy_pass http://127.0.0.1:10002;
            proxy_http_version 1.1;
            ${TTYD_AUTH_HEADER}
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 24h;
            proxy_buffering off;

            # ttyd's page is a single self-contained HTML document (no
            # external assets), so this only has to fire once per pane load,
            # not on every websocket frame. See /booth-assets/fonts/ above.
            # sub_filter cannot rewrite a compressed body, and a real browser
            # (unlike curl) sends Accept-Encoding: gzip by default — without
            # this, ttyd answers compressed and the filter below silently
            # never matches. Same fix the /proxy/ location already needed.
            proxy_set_header Accept-Encoding "";
            sub_filter_once on;
            sub_filter '<head>' '<head><link rel="preload" as="font" type="font/woff2" href="/booth-assets/fonts/FiraCodeNerdFontMono-Regular.woff2" crossorigin><link rel="preload" as="font" type="font/woff2" href="/booth-assets/fonts/FiraCodeNerdFontMono-Bold.woff2" crossorigin><style>@font-face{font-family:FiraCode Nerd Font Mono;font-weight:400;font-style:normal;font-display:swap;src:url(/booth-assets/fonts/FiraCodeNerdFontMono-Regular.woff2) format("woff2");}@font-face{font-family:FiraCode Nerd Font Mono;font-weight:700;font-style:normal;font-display:swap;src:url(/booth-assets/fonts/FiraCodeNerdFontMono-Bold.woff2) format("woff2");}</style><script>document.fonts.ready.then(function(){var checks=0;function check(){checks++;var t=window.term,s=t&&t._core&&t._core._charSizeService;if(s){try{var c=document.createElement("canvas").getContext("2d");c.font=(t.options.fontSize||15)+"px "+t.options.fontFamily;var want=c.measureText("W").width;if(Math.abs(s.width-want)>2){window.dispatchEvent(new Event("resize"));}}catch(e){}}if(checks<30){setTimeout(check,500);}}check();});</script>';
        }

        location /s3/ {
            if ($booth_auth_ok = 0) {
                return 302 /login;
            }

            proxy_pass http://127.0.0.1:10003;
            proxy_http_version 1.1;
            ${TTYD_AUTH_HEADER}
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 24h;
            proxy_buffering off;

            # ttyd's page is a single self-contained HTML document (no
            # external assets), so this only has to fire once per pane load,
            # not on every websocket frame. See /booth-assets/fonts/ above.
            # sub_filter cannot rewrite a compressed body, and a real browser
            # (unlike curl) sends Accept-Encoding: gzip by default — without
            # this, ttyd answers compressed and the filter below silently
            # never matches. Same fix the /proxy/ location already needed.
            proxy_set_header Accept-Encoding "";
            sub_filter_once on;
            sub_filter '<head>' '<head><link rel="preload" as="font" type="font/woff2" href="/booth-assets/fonts/FiraCodeNerdFontMono-Regular.woff2" crossorigin><link rel="preload" as="font" type="font/woff2" href="/booth-assets/fonts/FiraCodeNerdFontMono-Bold.woff2" crossorigin><style>@font-face{font-family:FiraCode Nerd Font Mono;font-weight:400;font-style:normal;font-display:swap;src:url(/booth-assets/fonts/FiraCodeNerdFontMono-Regular.woff2) format("woff2");}@font-face{font-family:FiraCode Nerd Font Mono;font-weight:700;font-style:normal;font-display:swap;src:url(/booth-assets/fonts/FiraCodeNerdFontMono-Bold.woff2) format("woff2");}</style><script>document.fonts.ready.then(function(){var checks=0;function check(){checks++;var t=window.term,s=t&&t._core&&t._core._charSizeService;if(s){try{var c=document.createElement("canvas").getContext("2d");c.font=(t.options.fontSize||15)+"px "+t.options.fontFamily;var want=c.measureText("W").width;if(Math.abs(s.width-want)>2){window.dispatchEvent(new Event("resize"));}}catch(e){}}if(checks<30){setTimeout(check,500);}}check();});</script>';
        }

        location /s4/ {
            if ($booth_auth_ok = 0) {
                return 302 /login;
            }

            proxy_pass http://127.0.0.1:10004;
            proxy_http_version 1.1;
            ${TTYD_AUTH_HEADER}
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 24h;
            proxy_buffering off;

            # ttyd's page is a single self-contained HTML document (no
            # external assets), so this only has to fire once per pane load,
            # not on every websocket frame. See /booth-assets/fonts/ above.
            # sub_filter cannot rewrite a compressed body, and a real browser
            # (unlike curl) sends Accept-Encoding: gzip by default — without
            # this, ttyd answers compressed and the filter below silently
            # never matches. Same fix the /proxy/ location already needed.
            proxy_set_header Accept-Encoding "";
            sub_filter_once on;
            sub_filter '<head>' '<head><link rel="preload" as="font" type="font/woff2" href="/booth-assets/fonts/FiraCodeNerdFontMono-Regular.woff2" crossorigin><link rel="preload" as="font" type="font/woff2" href="/booth-assets/fonts/FiraCodeNerdFontMono-Bold.woff2" crossorigin><style>@font-face{font-family:FiraCode Nerd Font Mono;font-weight:400;font-style:normal;font-display:swap;src:url(/booth-assets/fonts/FiraCodeNerdFontMono-Regular.woff2) format("woff2");}@font-face{font-family:FiraCode Nerd Font Mono;font-weight:700;font-style:normal;font-display:swap;src:url(/booth-assets/fonts/FiraCodeNerdFontMono-Bold.woff2) format("woff2");}</style><script>document.fonts.ready.then(function(){var checks=0;function check(){checks++;var t=window.term,s=t&&t._core&&t._core._charSizeService;if(s){try{var c=document.createElement("canvas").getContext("2d");c.font=(t.options.fontSize||15)+"px "+t.options.fontFamily;var want=c.measureText("W").width;if(Math.abs(s.width-want)>2){window.dispatchEvent(new Event("resize"));}}catch(e){}}if(checks<30){setTimeout(check,500);}}check();});</script>';
        }

        location /booth-messages/api/ {
            # 401 rather than a redirect: these are fetch() calls from the
            # overlay, and a 302 would hand them the login page as "JSON".
            if ($booth_auth_ok = 0) {
                return 401;
            }

            proxy_pass http://127.0.0.1:10007;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_buffering off;
        }

        # Web proxy: /proxy/{port}/{path}
        # Allows accessing container-internal web services through the booth port.
        # URL rewriting is best-effort via sub_filter; dynamic JS URLs won't be rewritten.
        location ~ ^/proxy/(\d+)(/.*)$ {
            if ($booth_auth_ok = 0) {
                return 302 /login;
            }

            set $proxy_port $1;
            set $proxy_path $2;

            proxy_pass http://127.0.0.1:$proxy_port$proxy_path$is_args$args;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Accept-Encoding "";
            proxy_read_timeout 24h;
            proxy_buffering off;

            # proxy_pass uses variables, so nginx's default redirect rewrite is
            # off. A backend Location: / would then resolve against the booth
            # origin and the pane would recursively load the console UI.
            proxy_redirect / /proxy/$proxy_port/;
            proxy_redirect http://127.0.0.1:$proxy_port/ /proxy/$proxy_port/;
            proxy_redirect http://localhost:$proxy_port/ /proxy/$proxy_port/;
            proxy_redirect http://127.0.0.1/ /proxy/$proxy_port/;
            proxy_redirect http://localhost/ /proxy/$proxy_port/;

            # Strip frame-blocking headers so the proxied page can load in a pane iframe
            proxy_hide_header X-Frame-Options;
            proxy_hide_header Content-Security-Policy;

            sub_filter_types text/html text/css application/javascript;
            sub_filter_once off;
            sub_filter '<base href="/' '<base href="/proxy/$proxy_port/';

            sub_filter 'href="/'   'href="/proxy/$proxy_port/';
            sub_filter "href='/"   "href='/proxy/$proxy_port/";
            sub_filter 'src="/'    'src="/proxy/$proxy_port/';
            sub_filter "src='/"    "src='/proxy/$proxy_port/";
            sub_filter 'action="/' 'action="/proxy/$proxy_port/';
            sub_filter "action='/" "action='/proxy/$proxy_port/";

            sub_filter 'url(/'     'url(/proxy/$proxy_port/';
            sub_filter 'url("/'    'url("/proxy/$proxy_port/';
            sub_filter "url('/"    "url('/proxy/$proxy_port/";

            sub_filter 'fetch("/'  'fetch("/proxy/$proxy_port/';
            sub_filter "fetch('/"  "fetch('/proxy/$proxy_port/";
            sub_filter 'import("/' 'import("/proxy/$proxy_port/';
            sub_filter "import('/" "import('/proxy/$proxy_port/";
            sub_filter 'base: "/' 'base: "/proxy/$proxy_port/';
            sub_filter 'assets: "/' 'assets: "/proxy/$proxy_port/';

            # JS that builds API paths at runtime (viewmd's assetURL, etc.)
            # is not covered by fetch("/ or src="/. Rewrite the literal so
            # those requests stay under /proxy/{port}/.
            sub_filter '"/api/'    '"/proxy/$proxy_port/api/';
            sub_filter "'/api/"    "'/proxy/$proxy_port/api/";
        }

        # Same-origin SPAs (Appwrite console with APPWRITE_ENDPOINT_SAME_ORIGIN)
        # call `/v1/…` and `/console/…` on the booth host. Cookie is set by the
        # globe bar; Referer is the fallback. Prefix ^~ so this wins over the
        # catch-all.
        location ^~ /console/ {
            if ($booth_auth_ok = 0) {
                return 302 /login;
            }
            set $cb_up $cookie_cb_proxy_port;
            if ($cb_up = "") {
                set $cb_up $cb_proxy_ref;
            }
            if ($cb_up = "") {
                return 404;
            }
            proxy_pass http://127.0.0.1:$cb_up;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Accept-Encoding "";
            proxy_read_timeout 24h;
            proxy_buffering off;
            proxy_hide_header X-Frame-Options;
            proxy_hide_header Content-Security-Policy;
        }

        # AnythingLLM (and similar) fetch `/api/…` on the booth origin from
        # the globe pane. Same cookie/Referer pass-through as /v1/ above.
        location ^~ /api/ {
            if ($booth_auth_ok = 0) {
                return 302 /login;
            }
            set $cb_up $cookie_cb_proxy_port;
            if ($cb_up = "") {
                set $cb_up $cb_proxy_ref;
            }
            if ($cb_up = "") {
                return 404;
            }
            proxy_pass http://127.0.0.1:$cb_up;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Accept-Encoding "";
            proxy_read_timeout 24h;
            proxy_buffering off;
            proxy_hide_header X-Frame-Options;
            proxy_hide_header Content-Security-Policy;
        }

        location ^~ /v1/ {
            if ($booth_auth_ok = 0) {
                return 302 /login;
            }
            set $cb_up $cookie_cb_proxy_port;
            if ($cb_up = "") {
                set $cb_up $cb_proxy_ref;
            }
            if ($cb_up = "") {
                return 404;
            }
            proxy_pass http://127.0.0.1:$cb_up;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 24h;
            proxy_buffering off;
            proxy_hide_header X-Frame-Options;
            proxy_hide_header Content-Security-Policy;
        }

        # Exact `/` is the booth console. A globe-pane SPA that does
        # `window.location = "/"` (AnythingLLM after login) would otherwise
        # hit try_files and load index.html in the iframe — nested console.
        # Referer /proxy/<port>/ means bounce it back under the pane prefix.
        location = / {
            if ($booth_auth_ok = 0) {
                return 302 /login;
            }
            if ($cb_proxy_ref != "") {
                return 302 /proxy/$cb_proxy_ref/;
            }
            rewrite ^ /index.html last;
        }

        location / {
            if ($booth_auth_ok = 0) {
                return 302 /login;
            }
            try_files $uri $uri/ @cb_root;
        }

        location @cb_root {
            set $cb_up $cookie_cb_proxy_port;
            if ($cb_up = "") {
                set $cb_up $cb_proxy_ref;
            }
            if ($cb_proxy_skip = 1) {
                set $cb_up "";
            }
            if ($cb_up = "") {
                rewrite ^ /index.html last;
            }
            proxy_pass http://127.0.0.1:$cb_up;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_read_timeout 24h;
            proxy_buffering off;
            proxy_hide_header X-Frame-Options;
            proxy_hide_header Content-Security-Policy;
        }
    }
}
