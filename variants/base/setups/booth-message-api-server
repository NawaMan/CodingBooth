# -----------------------------------------------------------------------------
# booth-message-api-server
#
# Minimal HTTP server for booth message API using bash + socat.
# Endpoints:
#   GET  /booth-messages/api/list          — list pending messages as JSON
#   POST /booth-messages/api/respond/<id>  — write response file
#   POST /booth-messages/api/activity      — touch .last-activity (idle reset)
#   POST /booth-messages/api/shutdown      — request container shutdown
#   POST /booth-messages/api/restart       — request container restart
#   POST /booth-messages/api/countdown-shutdown — timer-driven shutdown
#   GET  /booth-messages/api/idle/state    — current idle pause/disable state
#   POST /booth-messages/api/idle/pause    — time-boxed pause {"seconds": N}
#   POST /booth-messages/api/idle/disable  — disable idle monitoring indefinitely
#   POST /booth-messages/api/idle/resume   — resume normal idle cadence
#   POST /booth-messages/api/idle/set-time — override base idle time {"seconds": N}
#
# Usage: booth-message-api-server <port>
# -----------------------------------------------------------------------------

PORT=${1:-10007}
MSG_DIR="/home/coder/code/.booth/.tmp/messages"

# Single-request handler — reads HTTP from stdin, writes response to stdout
handle_request() {
    local line method path
    local content_length=0

    # Read request line
    IFS= read -r line
    method="${line%% *}"
    path="${line#* }"
    path="${path%% *}"

    # Read headers until empty line
    while IFS= read -r line; do
        line="${line%$'\r'}"
        [ -z "$line" ] && break
        case "${line,,}" in
            content-length:*)
                content_length="${line#*: }"
                content_length="${content_length%$'\r'}"
                ;;
        esac
    done

    # Read body
    local body=""
    if [ "$content_length" -gt 0 ] 2>/dev/null; then
        body=$(head -c "$content_length")
    fi

    # Route
    case "$method" in
        GET)
            case "$path" in
                /booth-messages/api/list) handle_list ;;
                /booth-messages/api/idle/state) handle_idle_state ;;
                *) send_response 404 '{"error":"not found"}' ;;
            esac
            ;;
        POST)
            case "$path" in
                /booth-messages/api/respond/*)
                    local msg_id="${path##*/}"
                    handle_respond "$msg_id" "$body"
                    ;;
                /booth-messages/api/shutdown)
                    handle_lifecycle_signal ".shutdown-requested"
                    ;;
                /booth-messages/api/countdown-shutdown)
                    handle_countdown_shutdown
                    ;;
                /booth-messages/api/restart)
                    handle_lifecycle_signal ".restart-requested"
                    ;;
                /booth-messages/api/activity)
                    handle_activity
                    ;;
                /booth-messages/api/idle/pause)
                    handle_idle_pause "$body"
                    ;;
                /booth-messages/api/idle/disable)
                    handle_idle_disable
                    ;;
                /booth-messages/api/idle/resume)
                    handle_idle_resume
                    ;;
                /booth-messages/api/idle/set-time)
                    handle_idle_set_time "$body"
                    ;;
                *) send_response 404 '{"error":"not found"}' ;;
            esac
            ;;
        *) send_response 405 '{"error":"method not allowed"}' ;;
    esac
}

handle_list() {
    local json="["
    local first=true

    if [ -d "$MSG_DIR" ]; then
        for f in "$MSG_DIR"/*.msg.json; do
            [ -f "$f" ] || continue
            local base_name msg_id
            base_name=$(basename "$f")
            msg_id="${base_name%.msg.json}"
            # Skip if already responded
            [ -f "$MSG_DIR/${msg_id}.response.json" ] && continue
            if [ "$first" = true ]; then
                first=false
            else
                json="${json},"
            fi
            json="${json}$(cat "$f")"
        done
    fi

    json="${json}]"
    send_response 200 "$json"
}

handle_respond() {
    local msg_id="$1"
    local body="$2"

    mkdir -p "$MSG_DIR"

    # Extract answer from JSON body
    local answer
    answer=$(echo "$body" | sed -n 's/.*"answer" *: *"\([^"]*\)".*/\1/p')

    if [ -z "$answer" ]; then
        send_response 400 '{"error":"missing answer"}'
        return
    fi

    printf '{"id":"%s","answer":"%s","answered":"%s"}' \
        "$msg_id" "$answer" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        > "$MSG_DIR/${msg_id}.response.json"

    send_response 200 '{"ok":true}'
}

handle_activity() {
    local tmp_dir="/home/coder/code/.booth/.tmp"
    mkdir -p "$tmp_dir"
    date +%s > "$tmp_dir/.last-activity"
    send_response 200 '{"ok":true}'
}

handle_countdown_shutdown() {
    # Write exit code marker if configured, then trigger shutdown
    if [ -n "${BOOTH_COUNT_DOWN_EXIT_CODE:-}" ]; then
        echo "$BOOTH_COUNT_DOWN_EXIT_CODE" > /tmp/.booth-exit-code
    fi
    handle_lifecycle_signal ".shutdown-requested"
}

handle_lifecycle_signal() {
    local marker="$1"
    local tmp_dir="/home/coder/code/.booth/.tmp"
    mkdir -p "$tmp_dir"
    touch "$tmp_dir/$marker"
    send_response 200 '{"ok":true}'
}

# Idle pause/disable/resume handlers — mirror the lifecycle-signal pattern.
# State files live under .booth/.tmp/ and are consumed by booth--idle-monitor.

handle_idle_pause() {
    # Time-boxed pause: accept {"seconds": N} and store now+N in .idle-pause-until.
    local body="$1"
    local seconds
    seconds=$(echo "$body" | sed -n 's/.*"seconds" *: *\([0-9][0-9]*\).*/\1/p')
    if [ -z "$seconds" ] || [ "$seconds" -le 0 ] 2>/dev/null; then
        send_response 400 '{"error":"seconds must be a positive integer"}'
        return
    fi
    # Hard cap at 7 days — anything more likely indicates a client bug.
    if [ "$seconds" -gt 604800 ]; then
        send_response 400 '{"error":"seconds exceeds 7-day maximum"}'
        return
    fi
    local tmp_dir="/home/coder/code/.booth/.tmp"
    mkdir -p "$tmp_dir"
    # Pausing clears an active Disable — they are mutually exclusive.
    rm -f "$tmp_dir/.idle-disabled"
    echo $(( $(date +%s) + seconds )) > "$tmp_dir/.idle-pause-until"
    send_response 200 '{"ok":true}'
}

handle_idle_disable() {
    local tmp_dir="/home/coder/code/.booth/.tmp"
    mkdir -p "$tmp_dir"
    touch "$tmp_dir/.idle-disabled"
    # Disabling supersedes any time-boxed Pause; clear it for consistency.
    rm -f "$tmp_dir/.idle-pause-until"
    send_response 200 '{"ok":true}'
}

handle_idle_resume() {
    local tmp_dir="/home/coder/code/.booth/.tmp"
    mkdir -p "$tmp_dir"
    rm -f "$tmp_dir/.idle-disabled" "$tmp_dir/.idle-pause-until"
    send_response 200 '{"ok":true}'
}

handle_idle_set_time() {
    # Override the base idle time for this session. Writes .idle-base-override;
    # the monitor re-reads it every ~10s. Cleared on restart.
    local body="$1"
    local seconds
    seconds=$(echo "$body" | sed -n 's/.*"seconds" *: *\([0-9][0-9]*\).*/\1/p')
    if [ -z "$seconds" ] || [ "$seconds" -le 0 ] 2>/dev/null; then
        send_response 400 '{"error":"seconds must be a positive integer"}'
        return
    fi
    if [ "$seconds" -gt 604800 ]; then
        send_response 400 '{"error":"seconds exceeds 7-day maximum"}'
        return
    fi
    local tmp_dir="/home/coder/code/.booth/.tmp"
    mkdir -p "$tmp_dir"
    echo "$seconds" > "$tmp_dir/.idle-base-override"
    send_response 200 '{"ok":true}'
}

handle_idle_state() {
    local tmp_dir="/home/coder/code/.booth/.tmp"
    local base_idle_time="${BOOTH_IDLE_TIME:-0}"
    local idle_time="$base_idle_time"
    # Runtime override replaces the env-var base if present and positive.
    if [ -f "$tmp_dir/.idle-base-override" ]; then
        local override
        override=$(cat "$tmp_dir/.idle-base-override" 2>/dev/null)
        if [ -n "$override" ] && [ "$override" -gt 0 ] 2>/dev/null; then
            idle_time="$override"
        fi
    fi
    local shutdown_time="${BOOTH_IDLE_SHUTDOWN_TIME:-60}"
    local enabled="false"
    [ "$base_idle_time" -gt 0 ] 2>/dev/null && enabled="true"
    local disabled="false"
    [ -f "$tmp_dir/.idle-disabled" ] && disabled="true"
    local pause_until=0
    if [ -f "$tmp_dir/.idle-pause-until" ]; then
        pause_until=$(cat "$tmp_dir/.idle-pause-until" 2>/dev/null)
        [ -z "$pause_until" ] && pause_until=0
    fi
    send_response 200 "{\"enabled\":$enabled,\"idle_time\":$idle_time,\"base_idle_time\":$base_idle_time,\"shutdown_time\":$shutdown_time,\"disabled\":$disabled,\"pause_until\":$pause_until}"
}

send_response() {
    local code="$1"
    local body="$2"
    local status_text="OK"
    [ "$code" = "400" ] && status_text="Bad Request"
    [ "$code" = "404" ] && status_text="Not Found"
    [ "$code" = "405" ] && status_text="Method Not Allowed"

    printf "HTTP/1.0 %s %s\r\nContent-Type: application/json\r\nContent-Length: %s\r\nConnection: close\r\n\r\n%s" \
        "$code" "$status_text" "${#body}" "$body"
}

# If called with --handle, process a single request
if [ "${1:-}" = "--handle" ]; then
    handle_request
    exit 0
fi

# Listen and fork handler per connection
exec socat TCP-LISTEN:"$PORT",reuseaddr,fork SYSTEM:"bash '$0' --handle"
