# -----------------------------------------------------------------------------
# booth--idle-monitor
#
# Background daemon that prompts the user after BOOTH_IDLE_TIME seconds of
# inactivity. If the user does not respond within BOOTH_IDLE_SHUTDOWN_TIME
# seconds, the booth is shut down gracefully via booth--shutdown --yes.
#
# Runtime state (all ephemeral — cleared on container start/exit):
#   .booth/.tmp/.idle-pause-until  — epoch seconds; while now<value the watchdog
#                                    holds (time-boxed Pause). When now>=value
#                                    the file is removed and normal cadence
#                                    resumes.
#   .booth/.tmp/.idle-disabled     — presence ⇒ watchdog holds indefinitely
#                                    (Disabled; only removed by /idle/resume or
#                                    container restart).
#   .booth/.tmp/.idle-base-override — integer seconds overriding BOOTH_IDLE_TIME
#                                    for the current session (adjust from the
#                                    dialog). Ignored if absent or non-positive.
# Set by the overlay via /booth-messages/api/idle/{pause,disable,resume,set-time}
# or by answering the "Still there?" prompt with Pause / Disable.
#
# In web variants (codeserver, notebook, desktop), the prompt is shown via
# the message overlay. In terminal variants (base/console), the booth shuts
# down directly after the idle period (no interactive prompt).
# -----------------------------------------------------------------------------

set -uo pipefail

IDLE_TIME="${BOOTH_IDLE_TIME:-0}"
SHUTDOWN_TIME="${BOOTH_IDLE_SHUTDOWN_TIME:-60}"

# Exit if idle monitoring is not configured
if [ "$IDLE_TIME" -le 0 ] 2>/dev/null; then
    exit 0
fi

MSG_DIR="/home/coder/code/.booth/.tmp/messages"
TMP_DIR="/home/coder/code/.booth/.tmp"
DISABLE_FILE="$TMP_DIR/.idle-disabled"
PAUSE_UNTIL_FILE="$TMP_DIR/.idle-pause-until"
BASE_OVERRIDE_FILE="$TMP_DIR/.idle-base-override"
CHECK_INTERVAL=10  # how often hold/override state is re-sampled during a sleep
CURRENT_IDLE_TIME="$IDLE_TIME"  # updated by refresh_idle_time() each tick
mkdir -p "$MSG_DIR" "$TMP_DIR"

# Refresh CURRENT_IDLE_TIME from the runtime override file if present.
# Called at the start of each loop iteration and each sleep chunk so a
# mid-sleep change takes effect within CHECK_INTERVAL seconds.
refresh_idle_time() {
    if [ -f "$BASE_OVERRIDE_FILE" ]; then
        local override
        override=$(cat "$BASE_OVERRIDE_FILE" 2>/dev/null)
        if [ -n "$override" ] && [ "$override" -gt 0 ] 2>/dev/null; then
            CURRENT_IDLE_TIME="$override"
            return
        fi
    fi
    CURRENT_IDLE_TIME="$IDLE_TIME"
}

log() {
    echo "[booth--idle-monitor] $(date '+%Y-%m-%dT%H:%M:%S%z') $*" >&2
}

do_shutdown() {
    log "Shutting down booth."
    touch "$TMP_DIR/.idle-shutdown"
    touch "$TMP_DIR/.shutdown-requested"
    # Give the lifecycle watcher a chance to pick it up (web variants)
    sleep 3
    # If still alive, the watcher isn't running — shut down directly
    booth--shutdown --yes
    exit 0
}

# Return the epoch timestamp of the most recent user activity.
# The web overlay reports keyboard/mouse events via the API,
# which writes the timestamp to .last-activity.
last_activity() {
    local f="$TMP_DIR/.last-activity"
    if [ -f "$f" ]; then
        cat "$f" 2>/dev/null || echo 0
    else
        echo 0
    fi
}

# True iff a time-boxed Pause is currently in effect.
pause_active() {
    if [ -f "$PAUSE_UNTIL_FILE" ]; then
        local until now
        until=$(cat "$PAUSE_UNTIL_FILE" 2>/dev/null || echo 0)
        now=$(date +%s)
        if [ "$until" -gt "$now" ] 2>/dev/null; then
            return 0
        fi
        # Expired — clean up so state reflects reality.
        rm -f "$PAUSE_UNTIL_FILE"
    fi
    return 1
}

# True iff Pause or Disabled currently holds the watchdog.
hold_active() {
    [ -f "$DISABLE_FILE" ] && return 0
    pause_active && return 0
    return 1
}

# Block until no hold is in effect. Resamples every CHECK_INTERVAL.
wait_for_hold_release() {
    while hold_active; do
        sleep "$CHECK_INTERVAL"
    done
}

# Sleep for CURRENT_IDLE_TIME seconds in CHECK_INTERVAL-sized chunks. If a
# Pause/Disable is set mid-sleep, bail early so the outer loop can re-evaluate.
# The base-override is also re-read each chunk — if the user shortens the
# window below elapsed, the loop exits and the activity check runs immediately.
# Returns 0 if the full window elapsed without interruption, 1 if interrupted.
sleep_idle_window() {
    local elapsed=0
    while [ "$elapsed" -lt "$CURRENT_IDLE_TIME" ]; do
        local remaining=$((CURRENT_IDLE_TIME - elapsed))
        local step="$CHECK_INTERVAL"
        [ "$step" -gt "$remaining" ] && step="$remaining"
        sleep "$step"
        elapsed=$((elapsed + step))
        refresh_idle_time
        if hold_active; then
            return 1
        fi
    done
    return 0
}

log "Started: idle=$IDLE_TIME s, shutdown=$SHUTDOWN_TIME s"

while true; do
    # 0) Pick up any runtime override to the base idle time.
    refresh_idle_time

    # 1) Honor any Pause/Disable hold before starting a new idle window.
    if hold_active; then
        wait_for_hold_release
        continue
    fi

    # 2) Normal idle countdown, interruptible by Pause/Disable/override.
    SLEEP_START=$(date +%s)
    if ! sleep_idle_window; then
        continue
    fi

    # 3) Real activity during the window resets the timer.
    LAST=$(last_activity)
    if [ "$LAST" -gt "$SLEEP_START" ]; then
        log "Activity detected (last=$LAST, sleep_start=$SLEEP_START), resetting timer."
        continue
    fi

    # 4) Prompt the user with Pause/Disable options via the message overlay.
    MSG_ID="idle-$(date +%s%N)"
    MSG_FILE="$MSG_DIR/$MSG_ID.msg.json"
    RSP_FILE="$MSG_DIR/$MSG_ID.response.json"

    EXPIRES=$(date -u -d "+${SHUTDOWN_TIME} seconds" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null \
           || date -u -v "+${SHUTDOWN_TIME}S" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null \
           || echo "")

    cat > "$MSG_FILE" <<EOJSON
{
  "id": "$MSG_ID",
  "title": "Still using this booth?",
  "body": "This booth will shut down in $SHUTDOWN_TIME seconds if you do not respond.",
  "type": "idle-prompt",
  "expires": "$EXPIRES"
}
EOJSON

    log "Prompted user (msg=$MSG_ID, expires=$EXPIRES)"

    # Poll for response until shutdown time elapses
    WAITED=0
    RESPONDED=false
    while [ "$WAITED" -lt "$SHUTDOWN_TIME" ]; do
        if [ -f "$RSP_FILE" ]; then
            RESPONDED=true
            break
        fi
        sleep 1
        WAITED=$((WAITED + 1))
    done

    # Extract the answer before cleaning up
    ANSWER=""
    if [ "$RESPONDED" = true ] && [ -f "$RSP_FILE" ]; then
        ANSWER=$(sed -n 's/.*"answer" *: *"\([^"]*\)".*/\1/p' "$RSP_FILE" 2>/dev/null || echo "")
    fi
    rm -f "$MSG_FILE" "$RSP_FILE"

    if [ "$RESPONDED" = true ]; then
        case "$ANSWER" in
            ok|"I'm here")
                log "User acknowledged presence, resetting idle timer."
                ;;
            pause:*)
                SECS="${ANSWER#pause:}"
                if [ "$SECS" -gt 0 ] 2>/dev/null; then
                    [ "$SECS" -gt 604800 ] && SECS=604800
                    echo $(( $(date +%s) + SECS )) > "$PAUSE_UNTIL_FILE"
                    log "User paused idle for ${SECS}s."
                else
                    log "Ignoring invalid pause value: $ANSWER"
                fi
                ;;
            disable)
                touch "$DISABLE_FILE"
                log "User disabled idle monitoring."
                ;;
            *)
                log "User responded ($ANSWER), resetting idle timer."
                ;;
        esac
        continue
    fi

    log "Idle timeout reached after $((IDLE_TIME + SHUTDOWN_TIME))s total."
    do_shutdown
done
