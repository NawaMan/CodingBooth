# -----------------------------------------------------------------------------
# booth--msg
#
# Interactive terminal UI for booth messages. Shows a summary of toasts,
# then walks through interactive messages one by one.
#
# Usage:
#   booth--msg          — view and respond to pending messages
#   booth--msg list     — list all messages (pending + answered)
#   booth--msg dismiss  — dismiss all pending toasts
# -----------------------------------------------------------------------------

set -uo pipefail

MSG_DIR="${HOME}/code/.booth/.tmp/messages"

# Colors
if [[ -t 1 ]]; then
  BOLD='\033[1m' DIM='\033[2m' CYAN='\033[1;36m' GREEN='\033[1;32m'
  YELLOW='\033[1;33m' BLUE='\033[1;34m' RED='\033[1;31m' RESET='\033[0m'
else
  BOLD='' DIM='' CYAN='' GREEN='' YELLOW='' BLUE='' RED='' RESET=''
fi

SEP="  ──────────────────────────────────────"

# ── Inline menu helpers (ANSI escape codes) ──

# Read a single keypress, returning "UP", "DOWN", "SPACE", "ENTER", or the character
_read_key() {
  local key
  IFS= read -rsn1 key
  if [[ "$key" == $'\x1b' ]]; then
    read -rsn1 -t 0.1 key2
    read -rsn1 -t 0.1 key3
    case "$key3" in
      A) echo "UP" ;;
      B) echo "DOWN" ;;
      *) echo "OTHER" ;;
    esac
  elif [[ "$key" == "" ]]; then
    echo "ENTER"
  elif [[ "$key" == " " ]]; then
    echo "SPACE"
  else
    echo "$key"
  fi
}

# Render a single-select menu inline. Prints selected value to stdout.
# All drawing goes to stderr so $(...) captures only the result.
# Usage: ans=$(_inline_menu "opt1" "opt2" "opt3")
_inline_menu() {
  local -a items=("$@")
  local count=${#items[@]}
  local cur=0

  # Hide cursor
  printf '\033[?25l' >&2

  # Draw all items
  local i
  for (( i=0; i<count; i++ )); do
    if (( i == cur )); then
      printf '  \033[1;36m> %s\033[0m\n' "${items[$i]}" >&2
    else
      printf '    %s\n' "${items[$i]}" >&2
    fi
  done

  while true; do
    local key
    key=$(_read_key)
    case "$key" in
      UP)    (( cur > 0 )) && (( cur-- )) ;;
      DOWN)  (( cur < count - 1 )) && (( cur++ )) ;;
      ENTER)
        printf '\033[?25h' >&2
        echo "${items[$cur]}"
        return 0
        ;;
    esac

    # Redraw: move cursor up to the top of the list, then redraw
    printf '\033[%dA' "$count" >&2
    for (( i=0; i<count; i++ )); do
      if (( i == cur )); then
        printf '\r\033[K  \033[1;36m> %s\033[0m\n' "${items[$i]}" >&2
      else
        printf '\r\033[K    %s\n' "${items[$i]}" >&2
      fi
    done
  done
}

# Render a multi-select checklist inline. Prints comma-separated values to stdout.
# All drawing goes to stderr so $(...) captures only the result.
# Usage: ans=$(_inline_checklist "opt1" "opt2" "opt3")
_inline_checklist() {
  local -a items=("$@")
  local count=${#items[@]}
  local cur=0
  local -a checked=()
  for (( i=0; i<count; i++ )); do checked+=("0"); done

  printf '\033[?25l' >&2
  printf '  \033[2m(SPACE to toggle, ENTER to submit)\033[0m\n' >&2

  local i
  for (( i=0; i<count; i++ )); do
    local mark="[ ]"
    if (( i == cur )); then
      printf '  \033[1;36m> %s %s\033[0m\n' "$mark" "${items[$i]}" >&2
    else
      printf '    %s %s\n' "$mark" "${items[$i]}" >&2
    fi
  done

  while true; do
    local key
    key=$(_read_key)
    case "$key" in
      UP)    (( cur > 0 )) && (( cur-- )) ;;
      DOWN)  (( cur < count - 1 )) && (( cur++ )) ;;
      SPACE) (( checked[cur] = !checked[cur] )) ;;
      ENTER)
        printf '\033[?25h' >&2
        local result=""
        for (( i=0; i<count; i++ )); do
          if (( checked[i] )); then
            [[ -n "$result" ]] && result="${result},"
            result="${result}${items[$i]}"
          fi
        done
        [[ -z "$result" ]] && result="none"
        echo "$result"
        return 0
        ;;
    esac

    # Redraw: move up past items + hint line
    printf '\033[%dA' "$(( count + 1 ))" >&2
    printf '\r\033[K  \033[2m(SPACE to toggle, ENTER to submit)\033[0m\n' >&2
    for (( i=0; i<count; i++ )); do
      local mark="[ ]"
      (( checked[i] )) && mark="[x]"
      if (( i == cur )); then
        printf '\r\033[K  \033[1;36m> %s %s\033[0m\n' "$mark" "${items[$i]}" >&2
      else
        printf '\r\033[K    %s %s\n' "$mark" "${items[$i]}" >&2
      fi
    done
  done
}

# ── JSON helpers ──

json_field() {
  local json="$1" field="$2"
  echo "$json" | sed -n 's/.*"'"$field"'" *: *"\([^"]*\)".*/\1/p' | head -1
}

json_array() {
  local json="$1" field="$2"
  # Collapse to single line first (JSON is pretty-printed multi-line)
  echo "$json" | tr '\n' ' ' | sed -n 's/.*"'"$field"'" *: *\[\([^]]*\)\].*/\1/p' | tr ',' '\n' | sed 's/^ *"//;s/" *$//' | grep -v '^$'
}

is_expired() {
  local expires="$1"
  [[ -z "$expires" ]] && return 1
  local exp_epoch now_epoch
  exp_epoch=$(date -d "$expires" +%s 2>/dev/null) || return 1
  now_epoch=$(date +%s)
  (( now_epoch > exp_epoch ))
}

write_response() {
  local msg_id="$1" answer="$2"
  printf '{"id":"%s","answer":"%s","answered":"%s"}' \
    "$msg_id" "$answer" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    > "${MSG_DIR}/${msg_id}.response.json"
}

# ── Gather and categorize messages ──

is_recent() {
  local timestamp="$1" max_age="${2:-1800}"  # default 30 min
  [[ -z "$timestamp" ]] && return 1
  local ts_epoch now_epoch
  ts_epoch=$(date -d "$timestamp" +%s 2>/dev/null) || return 1
  now_epoch=$(date +%s)
  (( now_epoch - ts_epoch < max_age ))
}

gather_messages() {
  EXPIRED_TOASTS=()
  ACTIVE_TOASTS=()
  INTERACTIVE=()

  [[ -d "$MSG_DIR" ]] || return

  for f in "$MSG_DIR"/*.msg.json; do
    [[ -f "$f" ]] || continue
    local base_name="${f##*/}"
    local msg_id="${base_name%.msg.json}"

    local json expires msg_type created
    json=$(cat "$f")
    expires=$(json_field "$json" "expires")
    msg_type=$(json_field "$json" "type")
    created=$(json_field "$json" "created")
    local already_responded=false
    [[ -f "$MSG_DIR/${msg_id}.response.json" ]] && already_responded=true

    if [[ "$msg_type" == "toast" ]]; then
      if [[ "$already_responded" == true ]]; then
        # Show recently dismissed/expired toasts (within 30 min)
        if is_recent "$created"; then
          EXPIRED_TOASTS+=("$f")
        fi
      elif is_expired "$expires"; then
        write_response "$msg_id" "dismissed"
        EXPIRED_TOASTS+=("$f")
      else
        ACTIVE_TOASTS+=("$f")
      fi
    else
      [[ "$already_responded" == true ]] && continue
      if is_expired "$expires"; then
        write_response "$msg_id" "timeout"
      else
        INTERACTIVE+=("$f")
      fi
    fi
  done
}

# ── Handle a single interactive message ──

handle_message() {
  local file="$1"
  local json msg_id title body msg_type
  json=$(cat "$file")
  msg_id=$(json_field "$json" "id")
  title=$(json_field "$json" "title")
  body=$(json_field "$json" "body")
  msg_type=$(json_field "$json" "type")

  echo ""
  echo -e "  ${CYAN}${BOLD}${title}${RESET}"
  echo -e "  ${body}"
  echo ""

  case "$msg_type" in
    ok)
      echo -e "  ${BLUE}Press ENTER to acknowledge.${RESET}"
      read -r
      write_response "$msg_id" "ok"
      echo -e "  ${GREEN}-> ok${RESET}"
      ;;
    yes-no)
      echo -e "  ${BLUE}[y]es / [n]o${RESET}"
      while true; do
        read -rp "  > " ans
        case "${ans,,}" in
          y|yes) write_response "$msg_id" "yes"; echo -e "  ${GREEN}-> yes${RESET}"; break ;;
          n|no)  write_response "$msg_id" "no";  echo -e "  ${GREEN}-> no${RESET}";  break ;;
          *)     echo -e "  ${YELLOW}Please enter y or n${RESET}" ;;
        esac
      done
      ;;
    yes-no-cancel)
      echo -e "  ${BLUE}[y]es / [n]o / [c]ancel${RESET}"
      while true; do
        read -rp "  > " ans
        case "${ans,,}" in
          y|yes)    write_response "$msg_id" "yes";    echo -e "  ${GREEN}-> yes${RESET}";    break ;;
          n|no)     write_response "$msg_id" "no";     echo -e "  ${GREEN}-> no${RESET}";     break ;;
          c|cancel) write_response "$msg_id" "cancel"; echo -e "  ${GREEN}-> cancel${RESET}"; break ;;
          *)        echo -e "  ${YELLOW}Please enter y, n, or c${RESET}" ;;
        esac
      done
      ;;
    text)
      read -rp "  > " ans
      write_response "$msg_id" "$ans"
      echo -e "  ${GREEN}-> sent${RESET}"
      ;;
    password)
      read -srp "  > " ans
      echo ""
      write_response "$msg_id" "$ans"
      echo -e "  ${GREEN}-> sent${RESET}"
      ;;
    choice)
      local options items=()
      options=$(json_array "$json" "options")
      while IFS= read -r opt; do
        [[ -n "$opt" ]] && items+=("$opt")
      done <<< "$options"
      local ans
      ans=$(_inline_menu "${items[@]}")
      write_response "$msg_id" "$ans"
      echo -e "  ${GREEN}-> ${ans}${RESET}"
      ;;
    choice-text)
      local options items=()
      options=$(json_array "$json" "options")
      while IFS= read -r opt; do
        [[ -n "$opt" ]] && items+=("$opt")
      done <<< "$options"
      items+=("[ Type my own ]")
      local ans
      ans=$(_inline_menu "${items[@]}")
      if [[ "$ans" == "[ Type my own ]" ]]; then
        read -rp "  Type your answer: " ans
      fi
      write_response "$msg_id" "$ans"
      echo -e "  ${GREEN}-> ${ans}${RESET}"
      ;;
    radio)
      local options items=()
      options=$(json_array "$json" "options")
      while IFS= read -r opt; do
        [[ -n "$opt" ]] && items+=("$opt")
      done <<< "$options"
      local ans
      ans=$(_inline_menu "${items[@]}")
      write_response "$msg_id" "$ans"
      echo -e "  ${GREEN}-> ${ans}${RESET}"
      ;;
    checkbox)
      local options items=()
      options=$(json_array "$json" "options")
      while IFS= read -r opt; do
        [[ -n "$opt" ]] && items+=("$opt")
      done <<< "$options"
      local ans
      ans=$(_inline_checklist "${items[@]}")
      write_response "$msg_id" "$ans"
      echo -e "  ${GREEN}-> ${ans}${RESET}"
      ;;
    *)
      echo -e "  ${RED}Unknown message type: ${msg_type}${RESET}"
      ;;
  esac
}

# ── Main interactive flow ──

cmd_interactive() {
  gather_messages

  local total=$(( ${#EXPIRED_TOASTS[@]} + ${#ACTIVE_TOASTS[@]} + ${#INTERACTIVE[@]} ))

  if [[ $total -eq 0 ]]; then
    echo -e "${DIM}No pending messages.${RESET}"
    return
  fi

  echo ""
  echo -e "${CYAN}${BOLD}${total} message(s)${RESET}"

  # ── Expired toasts: one-liner each ──
  if [[ ${#EXPIRED_TOASTS[@]} -gt 0 ]]; then
    echo ""
    for f in "${EXPIRED_TOASTS[@]}"; do
      local json title expires
      json=$(cat "$f")
      title=$(json_field "$json" "title")
      expires=$(json_field "$json" "expires")
      local when=""
      if [[ -n "$expires" ]]; then
        when=$(date -d "$expires" "+%Y-%m-%d %H:%M" 2>/dev/null || echo "$expires")
      fi
      echo -e "  ${DIM}[expired ${when}] ${title}${RESET}"
    done
  fi

  # ── Active toasts: show in full, then auto-dismiss ──
  if [[ ${#ACTIVE_TOASTS[@]} -gt 0 ]]; then
    for f in "${ACTIVE_TOASTS[@]}"; do
      local json msg_id title body
      json=$(cat "$f")
      msg_id=$(json_field "$json" "id")
      title=$(json_field "$json" "title")
      body=$(json_field "$json" "body")
      echo -e "${SEP}"
      echo -e "  ${CYAN}${title}${RESET}"
      echo -e "  ${body}"
      write_response "$msg_id" "dismissed"
    done
  fi

  # ── Separator before interactive messages ──
  if [[ ${#INTERACTIVE[@]} -gt 0 ]]; then
    echo -e "${SEP}"
    echo ""
    echo -e "  ${BOLD}${#INTERACTIVE[@]} message(s) need your response.${RESET}"
    echo -e "  ${DIM}Press ENTER to continue...${RESET}"
    read -r

    # Walk through interactive messages one by one
    local i=1
    for f in "${INTERACTIVE[@]}"; do
      echo -e "${SEP}"
      echo -e "  ${DIM}(${i}/${#INTERACTIVE[@]})${RESET}"
      handle_message "$f"
      i=$((i + 1))
    done
  fi

  echo -e "${SEP}"
  echo ""
  echo -e "${GREEN}Done.${RESET}"
}

# ── Plain-text list ──

cmd_list() {
  [[ -d "$MSG_DIR" ]] || { echo -e "${DIM}No messages.${RESET}"; return; }

  local found=false
  for f in "$MSG_DIR"/*.msg.json; do
    [[ -f "$f" ]] || continue
    found=true
    local json base_name msg_id title msg_type
    json=$(cat "$f")
    base_name=$(basename "$f")
    msg_id="${base_name%.msg.json}"
    title=$(json_field "$json" "title")
    msg_type=$(json_field "$json" "type")

    if [[ -f "$MSG_DIR/${msg_id}.response.json" ]]; then
      local resp_json answer
      resp_json=$(cat "$MSG_DIR/${msg_id}.response.json")
      answer=$(json_field "$resp_json" "answer")
      echo -e "  ${DIM}${msg_id}${RESET}  [${GREEN}answered${RESET}]  ${title}  ${DIM}(${msg_type})${RESET}  answer=${BOLD}${answer}${RESET}"
    else
      echo -e "  ${DIM}${msg_id}${RESET}  [${YELLOW}pending${RESET}]  ${title}  ${DIM}(${msg_type})${RESET}"
    fi
  done

  [[ "$found" == false ]] && echo -e "${DIM}No messages.${RESET}"
}

# ── Dismiss all toasts ──

cmd_dismiss() {
  local dismissed=0
  [[ -d "$MSG_DIR" ]] || { echo -e "${DIM}No messages.${RESET}"; return; }
  for f in "$MSG_DIR"/*.msg.json; do
    [[ -f "$f" ]] || continue
    local base_name="${f##*/}"
    local msg_id="${base_name%.msg.json}"
    [[ -f "$MSG_DIR/${msg_id}.response.json" ]] && continue
    local json msg_type
    json=$(cat "$f")
    msg_type=$(json_field "$json" "type")
    if [[ "$msg_type" == "toast" ]]; then
      write_response "$msg_id" "dismissed"
      dismissed=$((dismissed + 1))
    fi
  done
  echo -e "${GREEN}Dismissed ${dismissed} toast(s).${RESET}"
}

# ── Main ──

case "${1:-}" in
  list)    cmd_list ;;
  dismiss) cmd_dismiss ;;
  ""|respond) cmd_interactive ;;
  *)
    echo "Usage: booth--msg [list|dismiss]"
    echo ""
    echo "  (no args)  View and respond to pending messages"
    echo "  list       List all messages (pending + answered)"
    echo "  dismiss    Dismiss all pending toasts"
    exit 1
    ;;
esac
