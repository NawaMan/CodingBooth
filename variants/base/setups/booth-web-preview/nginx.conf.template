# Public static preview controls. Application content always goes through the
# authenticated code-server /proxy route below, including WebSocket upgrades.
location ^~ /booth-preview/ {
    alias /usr/local/share/booth-web-preview/media/;
    add_header Cache-Control "no-cache";
}

location ~ ^/proxy/([0-9]+)(/.*)$ {
    set $proxy_port $1;
    proxy_pass http://127.0.0.1:${INNER_PORT};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Accept-Encoding "";
    proxy_read_timeout 24h;
    proxy_buffering off;

    # code-server rewrites root-relative Location headers already. Handle only
    # loopback absolute redirects here, so /proxy is never prefixed twice.
    proxy_redirect http://127.0.0.1:$proxy_port/ /proxy/$proxy_port/;
    proxy_redirect http://localhost:$proxy_port/ /proxy/$proxy_port/;
    include /opt/codingbooth/setups/libs/booth-proxy-response.conf;
}
