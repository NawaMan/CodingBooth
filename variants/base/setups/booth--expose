# booth--expose: Create a TCP tunnel to expose a container port on the host.
#
# Usage:
#   booth--expose <container-port> [external-port] [--permanent]
#
# Writes a control file to .booth/.tmp/tcp-tunnels/ that the host-side
# booth process watches. The host opens a local listener and forwards
# each connection via docker exec + socat into the container.

set -euo pipefail

TMP_DIR="$HOME/code/.booth/.tmp"
TUNNEL_DIR="$TMP_DIR/tcp-tunnels"
MANIFEST_FILE="$TMP_DIR/ports.json"
CONFIG_FILE="$HOME/code/.booth/config.toml"

# --- Usage ---
usage() {
    cat >&2 <<'EOF'
Usage: booth--expose <container-port> [external-port] [--permanent]
       booth--expose list

Create a TCP tunnel through the booth port, or list the booth's ports.

Arguments:
  container-port   Port of the service running inside the container (required)
  external-port    Port on the host to listen on (optional)
                   Defaults to the same port as container-port
                   Use +OFFSET for relative to the offset base (the booth port,
                   unless the booth was started with --offset-base), or a plain
                   number for absolute

Options:
  --permanent      Save tunnel to .booth/config.toml (requires --writable-booth)

Subcommands:
  list             Show published ports, runtime tunnels, and listening services

Examples:
  booth--expose 8080               # host:8080 -> container:8080
  booth--expose 8080 18080         # host:18080 -> container:8080
  booth--expose 8080 +8080         # host:<offset-base>+8080 -> container:8080
  booth--expose 5432 --permanent   # same, but persisted across restarts
  booth--expose list               # what is published and what is listening
EOF
    exit 1
}

# --- List: published ports (manifest) + runtime tunnels + listening services ---
#
# Combines three sources from inside the container:
#   - the run-time manifest .booth/.tmp/ports.json  (what the host publishes)
#   - the runtime tunnels    .booth/.tmp/tcp-tunnels (what booth--expose opened)
#   - `ss -tlnp`             (what is actually listening, and which process)
# so a port shows its host mapping (if any), whether it is serving, and the app.
expose_list() {
    # Map listening container ports -> process name. `ss -p` only names the
    # caller's own processes, so we read as coder first (names user services like
    # jupyter/node/code-server) and then, if available, as root to fill in any
    # still-unnamed ports. Every listening port is recorded ("-" until named) so
    # internal-only services still show up.
    declare -A LISTEN_PROC
    gather_ss() {
        local out local_addr port proc name
        out="$("$@" -H -tlnp 2>/dev/null || true)"
        while read -r _state _rq _sq local_addr _peer proc; do
            [[ -z "$local_addr" ]] && continue
            port="${local_addr##*:}"
            [[ "$port" =~ ^[0-9]+$ ]] || continue
            [[ -z "${LISTEN_PROC[$port]:-}" ]] && LISTEN_PROC["$port"]="-"
            name="$(printf '%s' "$proc" | grep -oP '\("\K[^"]+' | head -1 || true)"
            [[ -n "$name" ]] && LISTEN_PROC["$port"]="$name"
        done <<< "$out"
        return 0
    }
    gather_ss ss
    if command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
        gather_ss sudo ss
    fi

    printf '%-9s %-22s %-5s %-11s %-7s %s\n' CONTAINER HOST PROTO KIND STATUS SERVER

    declare -A SHOWN  # container ports already printed, so ss-only rows don't repeat

    # 1. Published ports from the manifest.
    if [[ -f "$MANIFEST_FILE" ]] && command -v jq >/dev/null 2>&1; then
        local cport ip hport proto source kind host status server
        while IFS=$'\t' read -r cport ip hport proto source; do
            [[ -z "$cport" ]] && continue
            # host_ip is coalesced in jq below; keep these as belt-and-suspenders.
            [[ -z "$ip" || "$ip" == "null" ]] && ip="0.0.0.0"
            [[ -z "$proto" || "$proto" == "null" ]] && proto="tcp"
            kind="published"
            [[ "$source" == *"front door"* ]] && kind="front door"
            host="${ip}:${hport}"
            if [[ -n "${LISTEN_PROC[$cport]:-}" ]]; then
                status="up"; server="${LISTEN_PROC[$cport]}"
            else
                status="DOWN"; server="-"
            fi
            printf '%-9s %-22s %-5s %-11s %-7s %s\n' "$cport" "$host" "$proto" "$kind" "$status" "$server"
            SHOWN["$cport"]=1
            # Coalesce host_ip (omitted for wildcard binds) so no @tsv field is
            # empty — a tab IFS would otherwise collapse it and shift the columns.
        done < <(jq -r '.published[] | [.container_port, (.host_ip // "0.0.0.0"), .host_port, (.proto // "tcp"), .source] | @tsv' "$MANIFEST_FILE" 2>/dev/null)
    fi

    # 2. Runtime tunnels.
    if [[ -d "$TUNNEL_DIR" ]]; then
        local f cport ext server
        for f in "$TUNNEL_DIR"/*; do
            [[ -f "$f" ]] || continue
            cport="$(basename "$f")"
            [[ "$cport" =~ ^[0-9]+$ ]] || continue
            ext="$(tr -d '[:space:]' < "$f")"
            server="${LISTEN_PROC[$cport]:-"-"}"
            printf '%-9s %-22s %-5s %-11s %-7s %s\n' "$cport" "127.0.0.1:${ext}" tcp tunnel up "$server"
            SHOWN["$cport"]=1
        done
    fi

    # 3. Listening ports that are neither published nor tunneled (internal only).
    local p
    for p in "${!LISTEN_PROC[@]}"; do
        [[ -n "${SHOWN[$p]:-}" ]] && continue
        printf '%-9s %-22s %-5s %-11s %-7s %s\n' "$p" "-" tcp internal up "${LISTEN_PROC[$p]}"
    done | sort -n
}

if [[ "${1:-}" == "list" || "${1:-}" == "ls" ]]; then
    expose_list
    exit 0
fi

# --- Parse args ---
CONTAINER_PORT=""
EXTERNAL_PORT=""
PERMANENT=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --permanent)
            PERMANENT=true
            shift
            ;;
        --help|-h)
            usage
            ;;
        *)
            if [[ -z "$CONTAINER_PORT" ]]; then
                CONTAINER_PORT="$1"
            elif [[ -z "$EXTERNAL_PORT" ]]; then
                EXTERNAL_PORT="$1"
            else
                echo "Error: unexpected argument: $1" >&2
                usage
            fi
            shift
            ;;
    esac
done

if [[ -z "$CONTAINER_PORT" ]]; then
    echo "Error: container-port is required." >&2
    usage
fi

# --- Validate container port ---
if ! [[ "$CONTAINER_PORT" =~ ^[0-9]+$ ]] || [[ "$CONTAINER_PORT" -lt 1 ]] || [[ "$CONTAINER_PORT" -gt 65535 ]]; then
    echo "Error: invalid container port: $CONTAINER_PORT" >&2
    exit 1
fi

# What a +OFFSET counts from. The host sets BOOTH_OFFSET_BASE only when the base
# has been moved off the booth port (--offset-base); otherwise the booth port is
# the base, which is what BOOTH_HOST_PORT holds.
OFFSET_BASE="${BOOTH_OFFSET_BASE:-${BOOTH_HOST_PORT:-10000}}"

# --- Resolve external port ---
if [[ -z "$EXTERNAL_PORT" ]]; then
    # Default: same port number on host
    EXTERNAL_PORT="$CONTAINER_PORT"
elif [[ "$EXTERNAL_PORT" =~ ^\+([0-9]+)$ ]]; then
    # Relative: +OFFSET
    OFFSET="${BASH_REMATCH[1]}"
    EXTERNAL_PORT=$((OFFSET_BASE + OFFSET))
elif ! [[ "$EXTERNAL_PORT" =~ ^[0-9]+$ ]]; then
    echo "Error: invalid external port: $EXTERNAL_PORT" >&2
    exit 1
fi

if [[ "$EXTERNAL_PORT" -lt 1 ]] || [[ "$EXTERNAL_PORT" -gt 65535 ]]; then
    echo "Error: external port out of range: $EXTERNAL_PORT" >&2
    exit 1
fi

# --- Check if tunnel already exists ---
if [[ -f "$TUNNEL_DIR/$CONTAINER_PORT" ]]; then
    echo "Error: tunnel for container port $CONTAINER_PORT already exists." >&2
    echo "       Remove $TUNNEL_DIR/$CONTAINER_PORT to reset." >&2
    exit 1
fi

# --- Write control file ---
mkdir -p "$TUNNEL_DIR"
echo "$EXTERNAL_PORT" > "$TUNNEL_DIR/$CONTAINER_PORT"

# --- Output ---
echo "TCP tunnel: host localhost:${EXTERNAL_PORT} -> container localhost:${CONTAINER_PORT}"

if [[ "$PERMANENT" == "true" ]]; then
    # Check if .booth/ is writable
    if [[ ! -w "$CONFIG_FILE" ]] && [[ ! -w "$(dirname "$CONFIG_FILE")" ]]; then
        echo ""
        echo "Cannot write to $CONFIG_FILE (booth directory is read-only)."
        echo "Use --writable-booth when starting the booth, or add the tunnel"
        echo "config to .booth/config.toml manually."
    else
        # Append tcp-tunnels section if not present, or add entry
        if grep -q '^\[tcp-tunnels\]' "$CONFIG_FILE" 2>/dev/null; then
            # Add entry under existing section
            sed -i "/^\[tcp-tunnels\]/a ${CONTAINER_PORT} = \"+${CONTAINER_PORT}\"" "$CONFIG_FILE"
        else
            # Append new section
            printf '\n[tcp-tunnels]\n%s = "+%s"\n' "$CONTAINER_PORT" "$CONTAINER_PORT" >> "$CONFIG_FILE"
        fi
        echo "Saved to $CONFIG_FILE"
    fi
else
    echo "Note: This tunnel is ephemeral and will not survive a booth restart."
    echo "      Use --permanent to save to .booth/config.toml."
fi
