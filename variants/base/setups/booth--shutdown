# -----------------------------------------------------------------------------
# booth--shutdown
#
# Gracefully shut down the CodingBooth container from within.
# Sends SIGTERM to all processes owned by the current user, which causes
# the main service (code-server, VNC, jupyter, ttyd, etc.) to exit,
# followed by runuser, tini, and the container itself.
#
# Flags:
#   --yes, -y   Skip confirmation prompt
#   --gui       Use graphical confirmation dialog (zenity/kdialog)
# -----------------------------------------------------------------------------

set -euo pipefail

YES=false
GUI=false
for arg in "$@"; do
    case "$arg" in
        --yes|-y) YES=true ;;
        --gui)    GUI=true ;;
    esac
done

if [ "$YES" = false ]; then
    if [ "$GUI" = true ]; then
        # Try zenity (XFCE/GNOME), then kdialog (KDE)
        if command -v zenity >/dev/null 2>&1; then
            zenity --question --title="CodingBooth" \
                --text="Shut down this CodingBooth container?\n\nAll sessions will be closed and the container will stop." \
                --ok-label="Shut Down" --cancel-label="Cancel" \
                --width=350 2>/dev/null || { exit 0; }
        elif command -v kdialog >/dev/null 2>&1; then
            kdialog --title "CodingBooth" \
                --yesno "Shut down this CodingBooth container?\n\nAll sessions will be closed and the container will stop." \
                --yes-label "Shut Down" --no-label "Cancel" 2>/dev/null || { exit 0; }
        else
            # Fallback to terminal
            read -rp "Shut down CodingBooth? [y/N]: " answer
            case "$answer" in
                [yY]|[yY][eE][sS]) ;;
                *) echo "Shutdown cancelled."; exit 0 ;;
            esac
        fi
    else
        read -rp "Shut down CodingBooth? [y/N]: " answer
        case "$answer" in
            [yY]|[yY][eE][sS]) ;;
            *) echo "Shutdown cancelled."; exit 0 ;;
        esac
    fi
fi

echo "🛑 Shutting down CodingBooth..."

# Determine exit code: marker file takes precedence, then env var, then 0
EXIT_CODE=0
if [ -f /tmp/.booth-exit-code ]; then
    EXIT_CODE=$(cat /tmp/.booth-exit-code 2>/dev/null || echo 0)
elif [ -n "${BOOTH_COUNT_DOWN_EXIT_CODE:-}" ]; then
    EXIT_CODE="$BOOTH_COUNT_DOWN_EXIT_CODE"
fi

# Write marker so the VS Code extension can detect shutdown has started
touch /tmp/.booth-shutting-down

# Give the extension a moment to detect the marker and show feedback
sleep 2

# SIGTERM first for graceful shutdown of services, then SIGHUP
# to bring down interactive shells (which ignore SIGTERM).
kill -TERM -1 2>/dev/null || true
sleep 1
kill -HUP  -1 2>/dev/null || true

exit "$EXIT_CODE"
