# -----------------------------------------------------------------------------
# booth--info
#
# Display information about the CodingBooth environment.
# This helps users and AI agents understand their container environment.
# -----------------------------------------------------------------------------

set -euo pipefail

CB_DIR="/opt/codingbooth"

# Colors (disabled if not a terminal)
if [[ -t 1 ]]; then
  BOLD='\033[1m'
  CYAN='\033[1;36m'
  GREEN='\033[1;32m'
  RESET='\033[0m'
else
  BOLD=''
  CYAN=''
  GREEN=''
  RESET=''
fi

echo -e "${BOLD}=== CodingBooth Environment ===${RESET}"
echo ""

# Version
if [[ -f "$CB_DIR/version.txt" ]]; then
  VERSION=$(cat "$CB_DIR/version.txt")
  echo -e "${CYAN}Version:${RESET}  $VERSION"
else
  echo -e "${CYAN}Version:${RESET}  (unknown)"
fi

# Variant (from environment variable set at runtime)
echo -e "${CYAN}Variant:${RESET}  ${BOOTH_VARIANT_TAG:-base}"

# Booth name
echo -e "${CYAN}Booth:${RESET}    ${BOOTH_CONTAINER_NAME:-unknown}"

echo ""
echo -e "${BOLD}=== Key Paths ===${RESET}"
echo ""
echo -e "${GREEN}/home/coder/code${RESET}        - Your project directory (mounted from host)"
echo -e "${GREEN}/opt/codingbooth/setups${RESET} - Available setup scripts"

echo ""
echo -e "${BOLD}=== Host Access ===${RESET}"
echo ""

# The name the host answers to from in here. Resolve it rather than trusting the
# variable: on Docker Desktop the name exists even without the --add-host the
# booth passes, and the resolved address is the one that will actually be dialed.
HOST_NAME="${BOOTH_HOST_NAME:-host.docker.internal}"
HOST_NAME_ADDR="$(getent hosts "$HOST_NAME" 2>/dev/null | awk '{print $1; exit}' || true)"

if [[ -n "$HOST_NAME_ADDR" ]]; then
  echo -e "${CYAN}Host:${RESET}     ${GREEN}${HOST_NAME}${RESET} -> ${HOST_NAME_ADDR}"
else
  echo -e "${CYAN}Host:${RESET}     ${HOST_NAME} (not resolvable -- host services unreachable by name)"
fi

# The host's own address on its network, as the host sees it. Unset when the
# host had nothing but loopback at launch.
if [[ -n "${BOOTH_HOST_IP:-}" ]]; then
  echo -e "${CYAN}Host IP:${RESET}  ${BOOTH_HOST_IP}  (\$BOOTH_HOST_IP -- the host's address on its own network)"
fi

echo ""
echo "Reach a service running on the host, e.g. one on port 3000:"
echo ""
echo "  curl http://${HOST_NAME}:3000/"
echo ""
echo "The service must be listening on all interfaces (0.0.0.0), not only on"
echo "127.0.0.1 -- a host-local bind is not reachable from inside a container."
echo "For the reverse direction -- a port in here, reachable on the host -- see"
echo "booth--expose."

echo ""
echo -e "${BOLD}=== Documentation ===${RESET}"
echo ""
echo "Available documentation in /opt/codingbooth/:"
echo ""

if [[ -f "$CB_DIR/README.md" ]]; then
  echo "  - README.md        : Main documentation -- Lean about CodingBooth."
fi
if [[ -f "$CB_DIR/LICENSE" ]]; then
  echo "  - LICENSE          : Apache 2.0 License."
fi
if [[ -f "$CB_DIR/AGENT.md" ]]; then
  echo "  - AGENT.md         : Instructions for AI agents (also at ~/AGENT.md)"
fi
if [[ -d "$CB_DIR/docs" ]]; then
  echo "  - docs/            : Full documentation (guides, references, implementation details)"
fi
if [[ -d "$CB_DIR/variants" ]]; then
  echo "  - variants/        : Dockerfiles for all variants"
fi

echo ""
echo -e "${BOLD}Further Information: ${RESET}"
echo "  cat /opt/codingbooth/version.txt     # Show version"
echo "  ls  /opt/codingbooth/setups/         # List available setup scripts"
echo "  cat /opt/codingbooth/README.md       # Read main documentation"
echo "  booth--envs                          # Show environment variables"
echo ""
