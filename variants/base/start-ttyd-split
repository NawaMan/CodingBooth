#!/usr/bin/env bash
set -euo pipefail

PORT=${1:-10000}
WEB_SPLIT_ROOT=/usr/local/share/ttyd-split
WRAPPER_DIR=/usr/local/share/booth-message-wrapper

# Everything the console runs sits just above its own port: the six panes on
# +1..+6 and the message API on +7. On the booth port that is 10001-10006 and
# 10007, as always; a second console started by hand (start-webconsole, 11111 by
# default) gets 11112-11117 and 11118, so it never touches the first one's.
SESSION_NAMES=(s1 s2 s3 s4 s5 s6)
SESSION_PORTS=($((PORT + 1)) $((PORT + 2)) $((PORT + 3)) $((PORT + 4)) $((PORT + 5)) $((PORT + 6)))
API_PORT=$((PORT + 7))
export S1_PORT=${SESSION_PORTS[0]} S2_PORT=${SESSION_PORTS[1]} S3_PORT=${SESSION_PORTS[2]} S4_PORT=${SESSION_PORTS[3]} S5_PORT=${SESSION_PORTS[4]} S6_PORT=${SESSION_PORTS[5]} API_PORT

# The console on the booth port keeps its well-known file names (other setups
# patch /tmp/ttyd-split.nginx.conf); any other console tags its files with
# its port.
if [[ "$PORT" == 10000 ]]; then FILE_TAG=""; else FILE_TAG="-$PORT"; fi
export FILE_TAG
NGINX_CONFIG=/tmp/ttyd-split${FILE_TAG}.nginx.conf

if [[ ! -f "$WEB_SPLIT_ROOT/index.html" ]]; then
    echo "Missing split UI: $WEB_SPLIT_ROOT/index.html" >&2
    exit 1
fi

if [[ ! -f "$WEB_SPLIT_ROOT/nginx.conf.template" ]]; then
    echo "Missing nginx template: $WEB_SPLIT_ROOT/nginx.conf.template" >&2
    exit 1
fi

if [[ ! -f "$WEB_SPLIT_ROOT/login.html" ]]; then
    echo "Missing login page: $WEB_SPLIT_ROOT/login.html" >&2
    exit 1
fi

if [[ ! -f "$WEB_SPLIT_ROOT/tiling.js" ]]; then
    echo "Missing layout engine: $WEB_SPLIT_ROOT/tiling.js" >&2
    exit 1
fi

# ---- Session gate -----------------------------------------------------------
#
# With a PASSWORD set, the panes used to be protected by ttyd's own HTTP Basic
# auth, which meant the browser's native credential dialog — a dialog whose
# username box is the browser's, always empty, and impossible to prefill from
# here. So the gate moved up to nginx: a random per-start token in a cookie,
# handed out by /booth-messages/api/login once the password checks out, and
# nginx replays the ttyd credential upstream so the pane never sees a 401.
#
# With no PASSWORD the map collapses to "default 1" and every gate in the
# config is dead weight — the UI is open exactly as it was before.
if [[ -n "${PASSWORD:-}" ]]; then
    BOOTH_AUTH_TOKEN=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')
    AUTH_MAP="map \$cookie_booth_auth \$booth_auth_ok {
        default              0;
        \"${BOOTH_AUTH_TOKEN}\" 1;
    }"
    TTYD_AUTH_HEADER="proxy_set_header Authorization \"Basic $(printf '%s' "coder:${PASSWORD}" | base64 -w0)\";"

    # Read by booth-message-api-server when it mints the cookie.
    export BOOTH_AUTH_TOKEN
    export BOOTH_AUTH_USER=coder
    # Caddy terminates TLS in front of us on 10443, so nginx only ever sees
    # plain HTTP — BOOTH_TLS is the only signal that the browser is on HTTPS.
    export BOOTH_AUTH_COOKIE_SECURE=$([[ "${BOOTH_TLS:-}" == "true" ]] && echo true || echo false)
else
    AUTH_MAP="map \$cookie_booth_auth \$booth_auth_ok {
        default 1;
    }"
    TTYD_AUTH_HEADER=""
fi
export AUTH_MAP TTYD_AUTH_HEADER

for i in "${!SESSION_NAMES[@]}"; do
    session_name="${SESSION_NAMES[$i]}"
    session_port="${SESSION_PORTS[$i]}"

    # -d 3 = libwebsockets LLL_ERR|LLL_WARN only. ttyd's default (7) also sets
    # LLL_NOTICE, which logs a tag/untag pair plus an access line for every
    # HTTP request - including the /__booth/health readiness poll hitting
    # this pane's /s1 base path every 5s, straight to docker logs. Errors and
    # warnings still print at 3.
    ttyd_args=(-W -i 127.0.0.1 -p "$session_port" -b "/$session_name" --writable -t 'fontFamily=FiraCode Nerd Font Mono' -d 3)
    if [[ -n "${PASSWORD:-}" ]]; then
        ttyd_args+=(-c "coder:${PASSWORD}")
    fi

    # Each pane's shell lives inside a tmux session named after the pane, not
    # bare `bash -l`. ttyd spawns a fresh process for every websocket
    # connection, so a plain shell dies with the connection — a page reload
    # (or any network blip) SIGHUPs it and takes a foreground job like a dev
    # server down with it. `new-session -A` creates the session once and
    # reattaches to it on every later connection instead, so the shell (and
    # whatever is running in it) survives a reload.
    #
    # Nothing restarts a ttyd that dies, and nginx only answers 502 for its pane
    # after that — so record the death, or a console whose panes all went dead
    # leaves no trace of when or how. A death during booth--shutdown/restart is
    # expected and not logged.
    (
        status=0
        ttyd "${ttyd_args[@]}" tmux new-session -A -s "$session_name" || status=$?
        if [[ ! -e /tmp/.booth-shutting-down && ! -e /tmp/.booth-restarting ]]; then
            booth--lifecycle-log console-pane-exited "pane=$session_name" "port=$session_port" "status=$status" || true
        fi
    ) &
done

# Optional project-checked-in starting layout/tabs for this console, read
# straight off the existing .booth/ bind mount — no docker -e / envsubst
# round trip needed the way a scalar setting like BOOTH_IDLE_TIME gets,
# since this is inherently structured (a layout name, plus an arbitrary
# list of tab addresses per pane) and doesn't fit config.toml's flat
# scalar/list schema without real Go changes. Shape:
#   { "layout": "quad", "panes": { "1": { "web": true, "tabs": [":3000"] } } }
# Validated with jq (already in the base image) so a hand-edited typo just
# falls back to no preset rather than breaking the console entirely; tab
# addresses are re-validated in the browser by the same parser the address
# bar itself uses, so anything bogus there just fails to open, same as
# typing it in would.
#
# console-spec (BOOTH_CONSOLE_SPEC) additionally controls whether the
# console *saves* its own layout/tabs back here as they change, and to
# which of two fixed locations — never a user-supplied path, so there's
# never a "wrong writable location" to misconfigure:
#   unset/other  -> read-only, same file, same as always
#   "shared"     -> .booth/console.json itself; needs --writable-booth to
#                   actually persist a save, since .booth/ is read-only
#                   otherwise (reading it never needed that)
#   "cache"      -> .booth/.tmp/console.json; already writable
#                   unconditionally, never git-committed
# Resolved and exported here, before the message API server starts below:
# it's a background job that forks per-connection handlers off *its own*
# environment snapshot, so exporting this any later would never reach it —
# same reason BOOTH_AUTH_TOKEN above is exported before that same server
# starts, not after.
case "${BOOTH_CONSOLE_SPEC:-}" in
    shared|"") CONSOLE_CONFIG_FILE="/home/coder/code/.booth/console.json" ;;
    cache)     CONSOLE_CONFIG_FILE="/home/coder/code/.booth/.tmp/console.json" ;;
    *)
        echo "⚠️  console-spec=\"${BOOTH_CONSOLE_SPEC}\" is not \"shared\" or \"cache\"; saving is disabled, but .booth/console.json is still read normally." >&2
        CONSOLE_CONFIG_FILE="/home/coder/code/.booth/console.json"
        BOOTH_CONSOLE_SPEC=""
        ;;
esac
export BOOTH_CONSOLE_SPEC="${BOOTH_CONSOLE_SPEC:-}"

BOOTH_CONSOLE_CONFIG_JSON="{}"
if [[ -f "$CONSOLE_CONFIG_FILE" ]]; then
    if parsed=$(jq -c . "$CONSOLE_CONFIG_FILE" 2>/dev/null); then
        # The JSON lands inside a <script> element, where a "</script>" or
        # "<!--" in any string would end it early and take the page's own
        # scripts with it. \u003c is the same "<" to JSON.parse.
        BOOTH_CONSOLE_CONFIG_JSON="${parsed//</\\u003c}"
    else
        echo "⚠️  $CONSOLE_CONFIG_FILE is not valid JSON; ignoring it." >&2
    fi
fi
export BOOTH_CONSOLE_CONFIG_JSON

# Message API server — serves booth message list/respond endpoints and
# handles the overlay's POSTs to /restart, /shutdown, /idle/*, and
# /countdown-shutdown.
booth-message-api-server "$API_PORT" &

# The two below are once per booth, not once per console: when a console is
# started next to a variant's own service (start-webconsole on a notebook booth), the
# variant's wrapper is already running them, and a second copy would act on
# every restart request and send every countdown toast twice.

# Lifecycle watcher — picks up .restart-requested / .shutdown-requested
# marker files written by the API server and runs booth--restart /
# booth--shutdown.
pgrep -f booth-lifecycle-watcher >/dev/null || booth-lifecycle-watcher &

# Timer notifier — sends toast messages at countdown thresholds
pgrep -f booth-timer-notifier >/dev/null || booth-timer-notifier &

export PORT
export BOOTH_CONTAINER_NAME="${BOOTH_CONTAINER_NAME:-CodingBooth}"
export BOOTH_HOST_PORT="${BOOTH_HOST_PORT:-$PORT}"
export BOOTH_SHOW_RUN_TIME="${BOOTH_SHOW_RUN_TIME:-}"
export BOOTH_SHOW_COUNT_DOWN="${BOOTH_SHOW_COUNT_DOWN:-}"
export BOOTH_IDLE_TIME="${BOOTH_IDLE_TIME:-0}"
export BOOTH_IDLE_SHUTDOWN_TIME="${BOOTH_IDLE_SHUTDOWN_TIME:-60}"
export WEB_SPLIT_SERVE=/tmp/ttyd-split-serve${FILE_TAG}
mkdir -p "$WEB_SPLIT_SERVE"
# The home-row picture in CodingBooth Help's Console Shortcuts tab. Optional:
# without it the tab is just the table.
cp "$WEB_SPLIT_ROOT/console-ui-tile-keys.webp" "$WEB_SPLIT_SERVE/" 2>/dev/null || true

# Inject the shared lifecycle-panel overlay (same file the wrapper variants
# use) and any registered plugins into index.html, mirroring
# booth-message-wrapper--setup.sh's start-booth-wrapped behaviour.
OVERLAY_HTML=$(cat "$WRAPPER_DIR/overlay.html")
export OVERLAY_HTML

# Identity for this container start. A booth is reached by port, and ports get
# reused: stop one booth, start another on the same port, and a browser tab left
# open from the first still shows its page. The page carries this id and the
# readiness gate reloads the page when the booth answering stops matching it.
# Regenerated per start, so a restart counts as a new instance too.
BOOTH_INSTANCE_ID=$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')
export BOOTH_INSTANCE_ID

# The readiness gate goes in <head>, so it is already polling before the panes
# it gates are parsed. The instance id is declared just ahead of it, in its own
# script, so the gate can read it on its very first probe.
BOOTH_READY_JS="<script>window.BOOTH_INSTANCE_ID=\"${BOOTH_INSTANCE_ID}\";</script>
<script>
$(cat "$WRAPPER_DIR/booth-ready.js")
</script>"
export BOOTH_READY_JS

# Feature-detected fullscreen + Keyboard Lock toggle behind the "Full
# screen" button below — see booth-keyboard-capture.js for why this can't
# just be a preventDefault() in this page's own key handlers.
BOOTH_KEYBOARD_CAPTURE_JS="<script>
$(cat "$WRAPPER_DIR/booth-keyboard-capture.js")
</script>"
export BOOTH_KEYBOARD_CAPTURE_JS

# The layout tree behind every layout — the toolbar presets and the i3-style
# Ctrl+Alt tiling shortcuts alike.
BOOTH_TILING_JS="<script>
$(cat "$WEB_SPLIT_ROOT/tiling.js")
</script>"
export BOOTH_TILING_JS

PLUGINS_HTML=""
if ls "$WRAPPER_DIR/plugins"/*.js >/dev/null 2>&1; then
  for plugin_file in "$WRAPPER_DIR/plugins"/*.js; do
    PLUGINS_HTML="${PLUGINS_HTML}
<!-- booth plugin: $(basename "$plugin_file") -->
<script>
$(cat "$plugin_file")
</script>"
  done
fi
export PLUGINS_HTML

# Tab icon for this console and its login page. The helper is a no-op (empty
# link, no nginx locations) when neither a project file nor the built-in mark
# is available, so a booth still starts.
BOOTH_FAVICON_LINK=""
FAVICON_LOCATIONS=""
if [[ -x /opt/codingbooth/setups/cb-booth-favicon.sh ]]; then
  FAVICON_OUT=/tmp/booth-favicon
  /opt/codingbooth/setups/cb-booth-favicon.sh "$FAVICON_OUT"
  BOOTH_FAVICON_LINK=$(cat "$FAVICON_OUT/link")
  FAVICON_LOCATIONS=$(cat "$FAVICON_OUT/locations")
fi
export BOOTH_FAVICON_LINK FAVICON_LOCATIONS

envsubst '${PORT} ${WEB_SPLIT_SERVE} ${AUTH_MAP} ${TTYD_AUTH_HEADER} ${BOOTH_INSTANCE_ID} ${S1_PORT} ${S2_PORT} ${S3_PORT} ${S4_PORT} ${S5_PORT} ${S6_PORT} ${API_PORT} ${FILE_TAG} ${FAVICON_LOCATIONS}' <"$WEB_SPLIT_ROOT/nginx.conf.template" >"$NGINX_CONFIG"
envsubst '${BOOTH_CONTAINER_NAME} ${BOOTH_FAVICON_LINK}' <"$WEB_SPLIT_ROOT/login.html" >"$WEB_SPLIT_SERVE/login.html"
envsubst '${BOOTH_CONTAINER_NAME} ${BOOTH_HOST_PORT} ${BOOTH_SHOW_RUN_TIME} ${BOOTH_SHOW_COUNT_DOWN} ${BOOTH_IDLE_TIME} ${BOOTH_IDLE_SHUTDOWN_TIME} ${OVERLAY_HTML} ${PLUGINS_HTML} ${BOOTH_READY_JS} ${BOOTH_KEYBOARD_CAPTURE_JS} ${BOOTH_TILING_JS} ${BOOTH_CONSOLE_CONFIG_JSON} ${BOOTH_CONSOLE_SPEC} ${BOOTH_FAVICON_LINK}' \
  <"$WEB_SPLIT_ROOT/index.html" >"$WEB_SPLIT_SERVE/index.html"

mkdir -p /tmp/nginx/body /tmp/nginx/proxy /tmp/nginx/fastcgi /tmp/nginx/uwsgi /tmp/nginx/scgi

exec nginx -c "$NGINX_CONFIG" -g 'daemon off;'
