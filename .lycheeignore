# Patterns lychee should skip when checking links.
# One regex per line. See: https://lychee.cli.rs/usage/excludes/

# Local-development URLs that only resolve on a running booth.
^https?://localhost(:\d+)?(/|$)

# LinkedIn returns 403 to non-browser user agents — known false positive.
^https?://(www\.)?linkedin\.com/

# The CodingBooth blog is built from blog/ into site/blog/ and also deployed at
# codingbooth.io/blog/. Local root-relative /blog/ links now resolve via --root-dir
# (see link-check.yaml), so these guard the externally-deployed absolute forms that
# can't be verified from a checkout. Other codingbooth.io / nawaman.net/blog links
# stay checked.
^/blog(/|$)
codingbooth\.io/blog(/|$)

# The tour deck is built from blog/ and deployed at codingbooth.io/tour/ at publish
# time — like the blog, it isn't reachable from a plain checkout.
codingbooth\.io/tour(/|$)

# Template placeholders like ${rel_url} in issue/workflow templates aren't real
# links; the URL-encoded "${" is "$%7B". Skip anything containing one.
\$%7B
